# 企微自动群发必填。开发者可以不在这家公司。
# 公司里能进企微后台的人，把下面 3 个数发给开发者填写。

# 1. work.weixin.qq.com → 我的企业 → 企业信息 → 企业ID
WECOM_CORP_ID=

# 2. 应用管理 → 自建应用（开通「客户联系」，可见范围包含群主）→ Secret
WECOM_SECRET=

# 应用 AgentId（不是群主账号）
WECOM_AGENT_ID=

# 3. 通讯录 → 点开将确认群发的成员 → 账号（92135 的 sender）
WECOM_SENDER=

# 可选。92120 的 owner_filter：填客户群群主 userid，逗号分隔，最多 100 个。
# 不填则拉取应用可见范围内全部群主的群；可见范围超过 1000 人必须填，否则报 81017。
WECOM_OWNER_USERID=

# 可先空着。运行 node server/list-groups.js 后会自动写入
WECOM_CHAT_ID=

# 要发的群名
WECOM_GROUP_NAME=群聊推送测试

# 有正式小程序再填。不填先发文字，群主确认后同学仍能看到文字里的入口说明
MINI_APPID=
MINI_SECRET=
MINI_COVER_MEDIA_ID=
