<view class="hot-page">
  <view class="hot-hero">
    <view class="hot-title">园区热议</view>
    <view wx:if="{{board.updatedText}}" class="hot-meta">更新于 {{board.updatedText}}</view>
  </view>

  <view wx:if="{{loading}}" class="page-loading">
    <view class="page-loading-dot"></view>
    <view>加载中…</view>
  </view>

  <view wx:elif="{{loadError}}" class="empty">
    <view class="empty-title">加载失败</view>
    <view>{{loadError}}</view>
  </view>

  <view wx:elif="{{items.length}}" class="hot-list">
    <view
      wx:for="{{items}}"
      wx:key="key"
      class="hot-item {{item.rankClass}}"
      hover-class="hot-item-on"
      hover-stay-time="80"
      data-id="{{item.contentId}}"
      data-type="{{item.contentType}}"
      bindtap="goDetail"
    >
      <view class="rank {{item.rankClass}}">{{item.rank}}</view>
      <view class="hot-body">
        <view class="hot-item-title">{{item.title}}</view>
        <view wx:if="{{item.summary}}" class="hot-item-summary">{{item.summary}}</view>
        <view class="hot-item-meta">
          <text wx:if="{{item.tag}}" class="hot-type">#{{item.tag}}</text>
          <view class="engage-item">
            <view class="engage-ic engage-ic-heart"></view>
            <text class="engage-num">{{item.likeCount || 0}}</text>
          </view>
          <view class="engage-item">
            <view class="engage-ic engage-ic-comment"></view>
            <text class="engage-num">{{item.commentCount || 0}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="empty">
    <view class="empty-title">本周暂无精选</view>
    <view>等管理员上架后会出现在这里</view>
  </view>
</view>
