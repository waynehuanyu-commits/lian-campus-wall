.hot-page {
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-x: hidden;
  background: transparent;
}

/* 页头直接落在背景上，不再用大色块 */
.hot-hero {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx 40rpx 20rpx;
}

.hot-title {
  color: var(--ink);
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.hot-meta {
  flex-shrink: 0;
  color: var(--ink-3);
  font-size: 22rpx;
}

.hot-list {
  padding: 0 24rpx;
}

.hot-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 16rpx;
  padding: 26rpx 28rpx 22rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 6rpx 20rpx rgba(10, 42, 122, 0.05);
  transition: transform 0.18s ease;
}

.hot-item-on {
  transform: scale(0.985);
}

.rank {
  position: relative;
  z-index: 0;
  width: 52rpx;
  flex-shrink: 0;
  padding-top: 2rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 800;
  font-style: italic;
  line-height: 1.2;
  color: var(--ink-4);
  font-variant-numeric: tabular-nums;
}

.rank.top1,
.rank.top2 { color: var(--brand); }
.rank.top3 { color: rgba(8,75,216, 0.7); }

.rank.top1::after {
  content: "";
  position: absolute;
  z-index: -1;
  left: 10rpx;
  right: 10rpx;
  bottom: 4rpx;
  height: 12rpx;
  border-radius: 2rpx;
  background: var(--lime);
}

.hot-body {
  flex: 1;
  min-width: 0;
}

.hot-item-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.hot-item-summary {
  margin-top: 6rpx;
  color: var(--ink-3);
  font-size: 26rpx;
  line-height: 1.5;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hot-item-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 14rpx;
}

.hot-type {
  max-width: 50%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: var(--brand);
  font-size: 22rpx;
  font-weight: 700;
}

.hot-item-meta .engage-item {
  gap: 6rpx;
  font-size: 22rpx;
}

.hot-item-meta .engage-ic {
  width: 28rpx;
  height: 28rpx;
}
