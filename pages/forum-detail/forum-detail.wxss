.detail-page {
  padding: 20rpx 24rpx 280rpx;
}

.detail-card {
  background: #fff;
  padding: 32rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(31, 35, 41, 0.04);
}

.author-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.author-meta {
  flex: 1;
  min-width: 0;
}

.author-name {
  font-size: 30rpx;
  font-weight: 650;
  color: #1f2329;
  line-height: 1.35;
}

.author-meta .meta {
  margin-top: 6rpx;
  line-height: 1.5;
  word-break: break-all;
}

.contact-hint {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a9199;
}

.detail-title {
  margin-top: 28rpx;
  font-size: 40rpx;
  font-weight: 760;
  line-height: 1.35;
}

.detail-content {
  margin-top: 18rpx;
  font-size: 30rpx;
  color: #3d4450;
  white-space: pre-wrap;
  line-height: 1.75;
}

.action-bar {
  margin-top: 28rpx;
  padding-top: 0;
  border-top: none;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.action-item {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #5b677a;
  font-weight: 600;
  position: relative;
  height: 68rpx;
  line-height: 68rpx;
  white-space: nowrap;
  border-radius: 18rpx;
  background: #f5f8fc;
  border: 1rpx solid rgba(47, 125, 255, 0.12);
  box-sizing: border-box;
}

.action-item.on {
  color: #2f7dff;
  font-weight: 700;
  background: #eef5ff;
  border-color: rgba(47, 125, 255, 0.35);
  box-shadow: 0 4rpx 12rpx rgba(47, 125, 255, 0.12);
}

.action-item.danger {
  color: #e11d48;
  background: #fff5f7;
  border-color: rgba(225, 29, 72, 0.18);
}

.share-item {
  overflow: hidden;
}

.share-hit {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  opacity: 0;
}

.share-hit::after {
  border: none;
}

.comment-head {
  margin: 0 0 12rpx;
  padding: 8rpx 8rpx 0;
  font-size: 28rpx;
  font-weight: 700;
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.comment-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 35, 41, 0.03);
}

.comment-card.depth-1 {
  margin-left: 48rpx;
  background: #fafbfc;
}

.comment-card.depth-2 {
  margin-left: 88rpx;
  background: #fafbfc;
}

.comment-card.depth-3,
.comment-card.depth-4,
.comment-card.depth-5 {
  margin-left: 120rpx;
  background: #fafbfc;
}

.avatar.sm {
  width: 64rpx;
  height: 64rpx;
}

.comment-main {
  flex: 1;
  min-width: 0;
}

.comment-name {
  font-size: 26rpx;
  font-weight: 650;
}

.comment-reply-to {
  margin-top: 6rpx;
  color: #2F7DFF;
  font-size: 22rpx;
}

.comment-text {
  margin-top: 8rpx;
  color: #3d4450;
  font-size: 28rpx;
  line-height: 1.65;
}

.comment-images {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 12rpx;
}

.comment-images image {
  width: 100%;
  aspect-ratio: 1 / 1;
  height: auto;
  border-radius: 12rpx;
  background: #f3f5f8;
  display: block;
  object-fit: cover;
}

.comment-images.cols-1 {
  grid-template-columns: 1fr;
}

.comment-images.cols-1 image {
  max-width: 360rpx;
  aspect-ratio: 1 / 1;
}

.comment-images.cols-2 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.comment-actions {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.comment-reply-btn {
  display: inline-flex;
  align-items: center;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #2f7dff;
  font-size: 22rpx;
  font-weight: 650;
  background: #eef5ff;
  border: 1rpx solid rgba(47, 125, 255, 0.2);
}

.comment-reply-btn.danger {
  color: #e11d48;
  background: #fff1f2;
  border-color: rgba(225, 29, 72, 0.18);
}

.empty.mini {
  background: #fff;
  border-radius: 20rpx;
  padding: 64rpx 0 80rpx;
}
