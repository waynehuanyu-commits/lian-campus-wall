.msg-page {
  min-height: 100%;
  background: #fff;
  box-sizing: border-box;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.msg-entries {
  display: flex;
  justify-content: space-evenly;
  padding: 40rpx 48rpx 28rpx;
}

.msg-entry {
  width: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.msg-entry-on {
  opacity: 0.72;
}

.msg-ico-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
}

.msg-ico {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
}

.msg-ico.like {
  background: #ff2442;
}

.msg-ico.comment {
  background: #2f7dff;
}

.msg-dot {
  position: absolute;
  top: 0;
  right: 0;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ff2442;
  border: 4rpx solid #fff;
  box-sizing: content-box;
}

.msg-label {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.2;
  color: #333;
  font-weight: 500;
}

.msg-sep {
  height: 16rpx;
  background: #f5f5f5;
}

.msg-section-title {
  padding: 28rpx 32rpx 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.msg-chats {
  background: #fff;
}

.msg-chat {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  position: relative;
}

.msg-chat + .msg-chat::before {
  content: '';
  position: absolute;
  left: 140rpx;
  right: 0;
  top: 0;
  height: 1rpx;
  background: #f0f0f0;
}

.msg-chat-on {
  background: #fafafa;
}

.msg-avatar-wrap {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
}

.msg-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #f2f2f2;
  display: block;
}

.msg-avatar-dot {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff2442;
  border: 4rpx solid #fff;
  box-sizing: content-box;
}

.msg-chat-main {
  flex: 1;
  min-width: 0;
}

.msg-chat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.msg-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.msg-time {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #bbb;
}

.msg-preview {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.msg-empty {
  padding: 80rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.msg-empty-title {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
  text-align: center;
}

.msg-empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #bbb;
  text-align: center;
}
