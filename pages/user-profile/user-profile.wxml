<view class="up-nav" style="padding-top: {{nav.top}}px; height: {{nav.height}}px;">
  <view class="up-back" bindtap="goBack" hover-class="up-back-on"></view>
</view>
<view wx:if="{{loading}}" class="page-loading">
  <view class="page-loading-dot"></view>
  <view>加载中…</view>
</view>

<view wx:elif="{{profile}}" class="profile-page">
  <view class="up-cover">
    <image class="up-cover-img" src="{{cover.src}}" mode="aspectFill" binderror="onCoverError" />
    <view class="up-cover-fade"></view>
    <text wx:if="{{cover.credit}}" class="up-cover-credit">{{cover.credit}}</text>
  </view>

  <view class="hero">
    <view class="profile">
      <image class="avatar-lg" src="{{profile.avatar}}" mode="aspectFill" />
      <view class="profile-main">
        <view class="nickname-row">
          <view class="nickname">{{profile.nickname}}</view>
          <view class="profile-more" catchtap="openMore">⋯</view>
        </view>
        <view wx:if="{{profile.bio}}" class="bio">{{profile.bio}}</view>
        <view class="pill-row">
          <view wx:if="{{profile.schoolText}}" class="school-pill">{{profile.schoolText}}</view>
          <view wx:if="{{profile.studentAuthApproved}}" class="soft-pill ok">学生已认证</view>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-wrap">
    <view class="empty-desc">为保护隐私，个人主页不展示发布过的内容</view>
  </view>
</view>

<view wx:else class="empty-wrap alone">
  <view class="empty-title">{{error || '用户不存在'}}</view>
</view>
<report-sheet id="report-sheet" />

<view wx:if="{{moreOpen}}" class="share-sheet-mask" catchtouchmove="noop" bindtap="closeMore">
  <view class="share-sheet" catchtap="noop">
    <view class="share-sheet-title">更多操作</view>
    <view class="share-sheet-item" bindtap="onReport">举报</view>
    <view class="share-sheet-cancel" bindtap="closeMore">取消</view>
  </view>
</view>
