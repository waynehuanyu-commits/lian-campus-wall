.profile-page {
  position: relative;
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* 自定义导航：只放返回键，胶囊在右侧 */
.up-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  padding-left: 20rpx;
  box-sizing: content-box;
  pointer-events: none;
}

.up-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255, 0.82);
  box-shadow: 0 4rpx 12rpx rgba(10,42,122, 0.12);
  pointer-events: auto;
  position: relative;
}

.up-back::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18rpx;
  height: 18rpx;
  margin: -9rpx 0 0 -5rpx;
  border-left: 4rpx solid var(--ink);
  border-bottom: 4rpx solid var(--ink);
  transform: rotate(45deg);
}

.up-back-on {
  background: #fff;
}

/* 顶部园区照片，与「我的」页同源（utils/cover.js） */
.up-cover {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 560rpx;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

.up-cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.up-cover-fade {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(244,245,242, 0) 0%, rgba(244,245,242, 0) 72%, rgba(244,245,242, 0.86) 90%, #E9EFFF 100%);
}

.up-cover-credit {
  position: absolute;
  right: 28rpx;
  top: 380rpx;
  color: rgba(255,255,255, 0.92);
  font-size: 20rpx;
  letter-spacing: 1rpx;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0, 0.35);
}

.profile-page > .hero,
.profile-page > .stats-row,
.profile-page > .tabs,
.profile-page > .list,
.profile-page > .empty-wrap {
  position: relative;
  z-index: 1;
}

.hero {
  padding: 456rpx 40rpx 28rpx;
}

.profile {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.avatar-lg {
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #E6E9EE;
  box-shadow: 0 0 0 6rpx #fff, 0 10rpx 24rpx rgba(10,42,122, 0.14);
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.nickname-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.nickname {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: var(--ink);
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.profile-more {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  color: var(--ink-3);
  font-size: 32rpx;
}

.bio {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.5;
}

.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.school-pill,
.soft-pill {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 6rpx;
  background: rgba(10,92,255, 0.12);
  color: var(--brand);
  font-size: 22rpx;
  font-weight: 600;
}

.stats-row {
  display: flex;
  align-items: center;
  margin: 0 24rpx 20rpx;
  padding: 28rpx 0;
  border-radius: 24rpx;
  background: rgba(255,255,255, 0.94);
  border: 1rpx solid rgba(255,255,255, 0.9);
  box-shadow: 0 6rpx 20rpx rgba(10,42,122, 0.05);
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  color: var(--ink);
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.stat-label {
  margin-top: 6rpx;
  color: var(--ink-3);
  font-size: 22rpx;
}

.stat-line {
  width: 1rpx;
  height: 48rpx;
  background: var(--line);
}

.tabs {
  display: flex;
  gap: 0;
  margin: 0 24rpx 16rpx;
  padding: 6rpx;
  border-radius: 999rpx;
  background: rgba(18,26,44, 0.05);
}

.tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 999rpx;
  color: var(--ink-3);
  font-size: 26rpx;
  font-weight: 500;
}

.tab.active {
  background: #fff;
  color: var(--ink);
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(18,26,44, 0.08);
}

.list {
  padding: 0 24rpx;
}

.post-card {
  margin-bottom: 16rpx;
  padding: 26rpx 28rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255, 0.94);
  border: 1rpx solid rgba(255,255,255, 0.9);
  box-shadow: 0 6rpx 20rpx rgba(10,42,122, 0.05);
  transition: transform 0.18s ease;
}

.post-card-hover {
  transform: scale(0.985);
}

.post-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.post-tag {
  color: var(--brand);
  font-size: 22rpx;
  font-weight: 700;
}

.post-time {
  color: var(--ink-4);
  font-size: 22rpx;
}

.post-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.45;
}

.post-content {
  margin-top: 6rpx;
  color: var(--ink-2);
  font-size: 28rpx;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.post-foot {
  display: flex;
  gap: 28rpx;
  margin-top: 16rpx;
}

.post-foot .engage-ic {
  width: 30rpx;
  height: 30rpx;
}

.empty-wrap {
  padding: 80rpx 24rpx;
  text-align: center;
}

.empty-wrap.alone {
  padding-top: 320rpx;
}

.empty-title {
  color: var(--ink-2);
  font-size: 28rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 10rpx;
  color: var(--ink-4);
  font-size: 24rpx;
}
