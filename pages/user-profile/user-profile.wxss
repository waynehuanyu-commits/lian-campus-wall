.profile-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 28rpx 32rpx 8rpx;
  background: #fff;
  border-bottom: 16rpx solid #f5f5f5;
}

.hero-wash,
.hero-orb {
  display: none;
}

.profile {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.avatar-lg {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  background: #f2f2f2;
  border: none;
  box-shadow: none;
  flex-shrink: 0;
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.nickname-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.nickname {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.25;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.profile-more {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f5f5f5;
  color: #999;
  font-size: 36rpx;
  line-height: 48rpx;
  text-align: center;
}

.bio {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.45;
}

.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.school-pill {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  border: none;
  color: #666;
  font-size: 22rpx;
  font-weight: 500;
}

.soft-pill {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.soft-pill.ok {
  color: #666;
  background: #f5f5f5;
}

.stats-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 22rpx 8rpx 8rpx;
}

.profile-actions {
  position: relative;
  z-index: 1;
  padding: 16rpx 0 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dm-btn {
  height: 80rpx;
  border-radius: 999rpx;
  background: #2f7dff;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0;
  box-shadow: none;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 760;
  color: #1f2329;
}

.stat-label {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: #9a8a90;
}

.stat-line {
  width: 1rpx;
  height: 40rpx;
  background: rgba(90, 60, 70, 0.1);
}

.tabs {
  display: flex;
  gap: 8rpx;
  margin: 8rpx 28rpx 18rpx;
  padding: 6rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.78);
}

.tab {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #9a8a90;
  font-weight: 500;
}

.tab.active {
  background: linear-gradient(145deg, #6aadff 0%, #2f7dff 100%);
  color: #fff;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(47, 125, 255, 0.25);
}

.list {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.post-card {
  padding: 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 28rpx rgba(30, 70, 140, 0.05);
}

.post-card-hover {
  background: #f7faff;
}

.post-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.post-tag {
  display: inline-flex;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 650;
  background: rgba(47, 125, 255, 0.1);
  color: #2f7dff;
}

.post-time {
  font-size: 22rpx;
  color: #b5a6ab;
}

.post-title {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 720;
  color: #1f2329;
  line-height: 1.4;
}

.post-content {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6f5f66;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.post-foot {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: 18rpx;
}

.post-foot .engage-item {
  color: #8a9199;
  font-size: 22rpx;
}

.post-foot .engage-ic {
  width: 28rpx;
  height: 28rpx;
}

.empty-wrap {
  margin: 48rpx 40rpx;
  text-align: center;
}

.empty-wrap.alone {
  padding-top: 160rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #5c4a52;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #b5a6ab;
}
