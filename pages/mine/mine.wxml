<view class="mine-page">
  <view class="mine-cover">
    <image class="mine-cover-img" src="{{cover.src}}" mode="aspectFill" binderror="onCoverError" />
    <view class="mine-cover-fade"></view>
    <text wx:if="{{cover.credit}}" class="mine-cover-credit">{{cover.credit}}</text>
  </view>
  <view class="hero">
    <view class="hero-bg">
      <view class="hero-wash"></view>
      <view class="hero-orb hero-orb-a"></view>
      <view class="hero-orb hero-orb-b"></view>
    </view>
    <view class="brand-mark">黎安话事</view>

    <view class="profile">
      <view class="avatar-wrap">
        <view class="avatar-hit">
          <image
            class="avatar-lg"
            src="{{avatarSrc || '/images/default-avatars/avatar-01.jpg'}}"
            mode="aspectFill"
            binderror="onAvatarError"
          />
          <button
            wx:if="{{!isGuest}}"
            class="avatar-choose"
            open-type="chooseAvatar"
            bindchooseavatar="onChooseAvatar"
          ></button>
        </view>
        <view wx:if="{{!isGuest}}" class="avatar-edit" catchtap="openAvatarSheet">
          <view class="avatar-edit-icon"></view>
        </view>
      </view>
      <view class="profile-main">
        <view class="nickname-row" bindtap="goEditNickname" hover-class="nickname-row-hover">
          <view class="nickname-text">{{user.nickname || '填写昵称'}}</view>
          <view class="nickname-edit">{{isGuest ? '登录' : '修改'}}</view>
        </view>
        <input
          wx:if="{{!isGuest}}"
          class="bio-input"
          maxlength="40"
          value="{{user.bio}}"
          placeholder="写一句个性签名"
          placeholder-class="ph"
          bindblur="onBioBlur"
        />
        <view wx:if="{{isGuest}}" class="bio-input guest-bio">登录后同步你的资料</view>
        <view wx:if="{{!isGuest}}" class="pill-row">
          <view
            wx:if="{{!user.officialLogin}}"
            class="school-pill {{user.schoolLocked ? 'done' : 'need'}}"
            bindtap="goSchool"
          >{{user.schoolLocked ? (schoolText || '已认证') : '去认证学校'}}</view>
          <view wx:if="{{user.officialLogin}}" class="soft-pill ok">官方账号</view>
          <view wx:if="{{user.appAdmin}}" class="soft-pill ok">小程序管理员</view>
          <view wx:if="{{studentAuthBadge}}" class="soft-pill {{studentAuthBadgeClass}}">{{studentAuthBadge}}</view>
          <view wx:if="{{accountStatus === 'banned'}}" class="soft-pill danger">已封禁</view>
          <view wx:if="{{accountStatus === 'muted'}}" class="soft-pill danger">禁言中</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{accountTip}}" class="notice">
    <view class="notice-title">账号提醒</view>
    <view class="notice-desc">{{accountTip}}</view>
  </view>

  <view class="nav-block">
    <view class="nav-item" bindtap="goMyPosts" hover-class="nav-item-hover">
      <view class="nav-copy">
        <view class="nav-title">我的帖子</view>
        <view class="nav-desc">我发过的帖子</view>
      </view>
    </view>
    <view class="nav-item" bindtap="goMyEngage" hover-class="nav-item-hover">
      <view class="nav-copy">
        <view class="nav-title">我赞过的 / 我评论过的</view>
        <view class="nav-desc">我主动做过的互动历史</view>
      </view>
    </view>
  </view>

  <view class="setting-block">
    <block wx:if="{{!isGuest && user.schoolLocked}}">
      <view class="setting-item">
        <view class="setting-title">展示学校标签</view>
        <switch checked="{{user.showSchoolTag}}" color="#084BD8" bindchange="onShowSchoolTagChange" />
      </view>
      <view class="setting-item" bindtap="goSchool" hover-class="nav-item-hover">
        <view class="setting-title">学生认证</view>
        <view class="setting-value">{{studentAuthText}}</view>
        <view class="setting-link">{{studentAuthAction}}</view>
      </view>
    </block>
    <view wx:if="{{!isGuest && user.id && !user.officialLogin}}" class="setting-item" bindtap="copyAccountId" hover-class="nav-item-hover">
      <view class="setting-title">账号编号</view>
      <view class="setting-value account-id-value">{{user.id}}</view>
      <view class="setting-link">复制</view>
    </view>
    <block wx:if="{{!isGuest && (user.officialLogin || user.officialLoginAllowed)}}">
      <view wx:if="{{user.officialLogin}}" class="setting-item" bindtap="leaveOfficial" hover-class="nav-item-hover">
        <view class="setting-title">退出黎安校园墙</view>
        <view class="setting-link">退出</view>
      </view>
      <view wx:else class="setting-item" bindtap="enterOfficial" hover-class="nav-item-hover">
        <view class="setting-title">登录黎安校园墙</view>
        <view class="setting-link">登录</view>
      </view>
    </block>
    <view class="setting-item" bindtap="openClipboardPost" hover-class="nav-item-hover">
      <view class="setting-title">从剪贴板打开帖子</view>
      <view class="setting-link">打开</view>
    </view>
    <view class="setting-item" bindtap="goAbout" hover-class="nav-item-hover">
      <view class="setting-title">关于我们</view>
      <view class="setting-link setting-arrow">›</view>
    </view>
  </view>

  <view wx:if="{{isGuest}}" class="setting-block">
    <view class="setting-item" bindtap="onLogin" hover-class="nav-item-hover">
      <view class="setting-copy">
        <view class="setting-title">登录</view>
        <view class="setting-desc">登录后可发帖、评论和收消息</view>
      </view>
      <view class="setting-link">登录</view>
    </view>
  </view>
  <view wx:else class="logout-wrap">
    <view class="logout-btn" bindtap="onLogout" hover-class="logout-btn-on">退出登录</view>
  </view>

  <view class="foot-note">浏览开放 · 发帖评论需学校认证</view>

  <view wx:if="{{avatarSheet}}" class="avatar-mask" catchtouchmove="noop" bindtap="closeAvatarSheet">
    <view class="avatar-sheet" catchtap="noop">
      <view class="avatar-group">
        <view class="avatar-option" hover-class="avatar-option-hover" data-source="album" bindtap="onPickPhoto">从相册选择</view>
        <view class="avatar-option" hover-class="avatar-option-hover" data-source="camera" bindtap="onPickPhoto">拍照</view>
      </view>
      <view class="avatar-option cancel" hover-class="avatar-option-hover" bindtap="closeAvatarSheet">取消</view>
    </view>
  </view>

  <privacy-popup />
</view>
