.mine-page {
  min-height: 100vh;
  background: #f3f6fb;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.hero {
  position: relative;
  overflow: visible;
  padding: 28rpx 28rpx 36rpx;
  background: linear-gradient(165deg, #eef4ff 0%, #dce9ff 42%, #f3f6fb 100%);
}

.hero-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  overflow: hidden;
  pointer-events: none;
}

.hero-wash {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 80% 60% at 10% 0%, rgba(255, 255, 255, 0.7), transparent 55%),
    radial-gradient(ellipse 70% 50% at 100% 20%, rgba(90, 160, 255, 0.22), transparent 50%);
  pointer-events: none;
}

.hero-orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(2rpx);
}

.hero-orb-a {
  width: 220rpx;
  height: 220rpx;
  right: -40rpx;
  top: -60rpx;
  background: rgba(47, 125, 255, 0.18);
}

.hero-orb-b {
  width: 160rpx;
  height: 160rpx;
  left: -50rpx;
  bottom: 20rpx;
  background: rgba(160, 200, 255, 0.16);
}

.brand-mark {
  position: relative;
  z-index: 1;
  margin-bottom: 28rpx;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  font-weight: 650;
  color: rgba(47, 125, 255, 0.85);
}

.profile {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.avatar-wrap {
  position: relative;
  z-index: 2;
  width: 132rpx;
  height: 132rpx;
  flex: 0 0 132rpx;
  overflow: visible;
}

.avatar-wrap-hover {
  opacity: 0.86;
}

.avatar-lg {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  display: block;
  background: #e8eef8;
  border: 4rpx solid #fff;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(47, 125, 255, 0.18);
}

.avatar-edit {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  z-index: 4;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #5b9dff 0%, #2f7dff 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
  box-shadow: 0 6rpx 16rpx rgba(47, 125, 255, 0.35);
  pointer-events: none;
}

.avatar-edit-icon {
  width: 20rpx;
  height: 16rpx;
  border: 3rpx solid #fff;
  border-radius: 4rpx;
  box-sizing: border-box;
  position: relative;
}

.avatar-edit-icon::before {
  content: "";
  position: absolute;
  top: -7rpx;
  left: 50%;
  margin-left: -5rpx;
  width: 10rpx;
  height: 5rpx;
  border-radius: 3rpx 3rpx 0 0;
  background: #fff;
}

.avatar-edit-icon::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 6rpx;
  height: 6rpx;
  margin: -3rpx 0 0 -3rpx;
  border-radius: 50%;
  border: 2rpx solid #fff;
  box-sizing: border-box;
}

.profile-main {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}

.nickname-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 52rpx;
  max-width: 100%;
}

.nickname-row-hover {
  opacity: 0.72;
}

.nickname-text {
  flex: 0 1 auto;
  min-width: 0;
  max-width: calc(100% - 96rpx);
  font-size: 36rpx;
  font-weight: 760;
  color: #1f2329;
  letter-spacing: 0.5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nickname-edit {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #2f7dff;
  background: rgba(47, 125, 255, 0.1);
}

.account-id-value {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bio-input {
  display: block;
  width: 100%;
  margin-top: 14rpx;
  padding: 0;
  height: 40rpx;
  min-height: 40rpx;
  line-height: 40rpx;
  font-size: 26rpx;
  color: #3d4f66;
  background: transparent;
  border: none;
}

.ph {
  color: #9aa8b8;
  font-size: 26rpx;
}

.pill-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
}

.school-pill {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(47, 125, 255, 0.1);
  border: none;
  color: #2f5f9e;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 44rpx;
  box-shadow: none;
}

.school-pill.done {
  background: rgba(47, 125, 255, 0.1);
  color: #2f5f9e;
}

.school-pill.need {
  color: #fff;
  background: linear-gradient(145deg, #6aadff 0%, #2f7dff 100%);
  box-shadow: 0 8rpx 18rpx rgba(47, 125, 255, 0.28);
}

.soft-pill {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.55);
  color: #7a8799;
  font-size: 20rpx;
}

.soft-pill.ok {
  color: #1f7a4c;
  background: rgba(232, 247, 239, 0.9);
}

.soft-pill.danger {
  color: #e11d48;
  background: rgba(255, 245, 247, 0.95);
}

.notice {
  margin: 0 24rpx 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #f5f8ff;
  border: 1rpx solid rgba(47, 125, 255, 0.12);
}

.notice-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #2f7dff;
}

.notice-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8a6b72;
  line-height: 1.5;
}

.nav-block {
  margin: 8rpx 24rpx 0;
  padding: 8rpx 8rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 40rpx rgba(30, 70, 140, 0.06);
}

.nav-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 22rpx;
}

.nav-item-hover {
  background: #f3f7ff;
}

.nav-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}

.nav-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.nav-dot.posts {
  background: #2f7dff;
  box-shadow: 0 0 0 8rpx rgba(47, 125, 255, 0.12);
}

.nav-dot.engage {
  background: #f0a35e;
  box-shadow: 0 0 0 8rpx rgba(240, 163, 94, 0.14);
}

.nav-dot.msg {
  background: #6b8cff;
  box-shadow: 0 0 0 8rpx rgba(107, 140, 255, 0.14);
}

.nav-dot.about {
  background: #7a8ca8;
  box-shadow: 0 0 0 8rpx rgba(122, 140, 168, 0.14);
}

.nav-copy {
  min-width: 0;
}

.nav-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.nav-tail {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.nav-reddot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ff2442;
  flex-shrink: 0;
}

.nav-reddot.num {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
  box-sizing: border-box;
}

.nav-badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #ff2442;
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
  box-sizing: border-box;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}

.nav-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9a8a90;
}

.nav-arrow {
  color: #d0c4c8;
  font-size: 36rpx;
  line-height: 1;
  font-weight: 300;
}

.setting-block {
  margin: 16rpx 24rpx 0;
  padding: 6rpx 8rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.7);
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 22rpx;
  border-radius: 18rpx;
}

.setting-copy {
  flex: 1;
  min-width: 0;
}

.setting-title {
  font-size: 28rpx;
  font-weight: 650;
  color: #2a2426;
}

.setting-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9a8a90;
}

.setting-link {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #2f7dff;
  font-weight: 600;
}

.foot-note {
  margin: 36rpx 40rpx 0;
  text-align: center;
  color: #b5a6ab;
  font-size: 22rpx;
  letter-spacing: 0.5rpx;
}

.avatar-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(20, 36, 64, 0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.avatar-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 0 24rpx calc(24rpx + env(safe-area-inset-bottom));
}

.avatar-group {
  overflow: hidden;
  border-radius: 24rpx;
  background: #fff;
}

.avatar-option {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 104rpx;
  padding: 0;
  margin: 0;
  border-radius: 0;
  background: #fff;
  color: #1f2329;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 104rpx;
  box-sizing: border-box;
}

.avatar-option.wx {
  width: 100%;
  border: none;
  color: #2f7dff;
}

.avatar-option.wx::after {
  border: none;
}

.avatar-group .avatar-option + .avatar-option {
  border-top: 1rpx solid #eef2f7;
}

.avatar-option.cancel {
  margin-top: 16rpx;
  border-radius: 24rpx;
  color: #8a9199;
  font-weight: 500;
}

.avatar-option-hover {
  background: #f4f7fb;
}

