<view class="page publish-page">
  <phone-sheet wx:if="{{blocked && blockAction === 'phone'}}" inline bind:bound="onPhoneBound" />
  <view wx:elif="{{blocked}}" class="empty">
    <view class="empty-title">{{blockTitle}}</view>
    <view>{{blockDesc}}</view>
    <button wx:if="{{blockAction === 'login'}}" class="btn-primary submit-btn" bindtap="goLogin">去开通发言</button>
    <button wx:elif="{{blockAction === 'auth'}}" class="btn-primary submit-btn" bindtap="goAuth">去认证学校</button>
  </view>

  <block wx:else>
    <view class="pub-card">
      <view class="pub-label">选择板块</view>
      <view class="topic-grid">
        <view
          wx:for="{{boards}}"
          wx:key="*this"
          class="topic-chip {{tag === item ? 'active' : ''}}"
          data-name="{{item}}"
          bindtap="onTagTap"
        >{{item}}</view>
      </view>
    </view>

    <view class="pub-card pub-editor">
      <view class="pub-label">{{titleLabel || '标题'}}</view>
      <input class="pub-title" maxlength="40" placeholder="{{titlePlaceholder}}" placeholder-class="pub-ph" value="{{title}}" bindinput="onTitleInput" />
      <view class="pub-divider"></view>
      <textarea
        class="pub-body"
        maxlength="800"
        placeholder="{{contentPlaceholder}}"
        placeholder-class="pub-ph"
        value="{{content}}"
        auto-height
        bindinput="onContentInput"
      />
      <view class="upload-grid">
        <view wx:for="{{images}}" wx:key="*this" class="upload-item">
          <image src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="previewImage" />
          <view class="upload-remove" data-index="{{index}}" catchtap="removeImage">×</view>
        </view>
        <view wx:if="{{images.length < maxImages}}" class="upload-add" bindtap="chooseImages">
          <view class="upload-add-ic"></view>
          <text>添加图片</text>
        </view>
      </view>
    </view>

    <view class="pub-card pub-list">
      <block wx:if="{{isRide}}">
        <view class="pub-row">
          <text class="pub-row-title">出发地（选填）</text>
          <input class="pub-row-input" maxlength="20" placeholder="例如：信息学部 / 东区大门" placeholder-class="pub-ph" value="{{routeFrom}}" bindinput="onRouteFromInput" />
        </view>
        <view class="pub-row">
          <text class="pub-row-title">目的地（选填）</text>
          <input class="pub-row-input" maxlength="20" placeholder="例如：汉口火车站 / 光谷" placeholder-class="pub-ph" value="{{routeTo}}" bindinput="onRouteToInput" />
        </view>
        <view class="pub-row">
          <text class="pub-row-title">出发时间（选填）</text>
          <input class="pub-row-input" maxlength="30" placeholder="例如：周五 16:00" placeholder-class="pub-ph" value="{{departTime}}" bindinput="onDepartTimeInput" />
        </view>
        <view class="pub-row">
          <text class="pub-row-title">空位 / 人数（选填）</text>
          <input class="pub-row-input" maxlength="20" placeholder="例如：还可坐 2 人" placeholder-class="pub-ph" value="{{extra}}" bindinput="onExtraInput" />
        </view>
      </block>
      <view wx:else class="pub-row">
        <text class="pub-row-title">{{extraLabel}}（选填）</text>
        <input class="pub-row-input" maxlength="30" placeholder="{{extraPlaceholder}}" placeholder-class="pub-ph" value="{{extraField}}" bindinput="onExtraFieldInput" />
      </view>
    </view>
    <view class="pub-note">线下交易请注意安全，平台不介入纠纷。</view>

    <view class="pub-submit-bar">
      <button class="pub-submit" bindtap="onSubmit" disabled="{{submitting || published}}" loading="{{submitting}}">{{published ? '已发布' : (submitting ? '发布中' : '发布到互助广场')}}</button>
    </view>
  </block>
  <privacy-popup />
</view>
