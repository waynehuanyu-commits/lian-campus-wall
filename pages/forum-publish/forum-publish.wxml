<view class="page padded publish-page">
  <view wx:if="{{blocked}}" class="empty">
    <view class="empty-title">{{blockTitle}}</view>
    <view>{{blockDesc}}</view>
    <button wx:if="{{blockAction === 'login'}}" class="btn-primary submit-btn" bindtap="goLogin">去开通发言</button>
    <button wx:elif="{{blockAction === 'auth'}}" class="btn-primary submit-btn" bindtap="goAuth">去认证学校</button>
  </view>

  <block wx:else>
  <view class="form-label">主题</view>
  <view class="topic-grid">
    <view
      wx:for="{{topics}}"
      wx:key="*this"
      class="topic-chip {{(tagMode === 'other' && item === otherTopic) || (tagMode !== 'other' && tag === item) ? 'active' : ''}}"
      data-name="{{item}}"
      bindtap="onTopicTap"
    >{{item}}</view>
  </view>

  <block wx:if="{{tagMode === 'other'}}">
    <view class="form-label topic-custom-label">自定义话题</view>
    <view class="field topic-field active">
      <input
        maxlength="8"
        placeholder="输入自己的话题，最多 8 个字"
        value="{{customTag}}"
        focus="{{otherFocus}}"
        bindinput="onCustomInput"
      />
    </view>
  </block>

  <view class="form-label">标题</view>
  <view class="field">
    <input placeholder="一句话讲清楚主题（选填）" value="{{title}}" bindinput="onTitleInput" />
  </view>

  <view class="form-label">正文（选填）</view>
  <view class="field">
    <textarea
      placeholder="分享新鲜事、提问、组队都可以"
      value="{{content}}"
      auto-height
      bindinput="onContentInput"
    />
  </view>

  <view class="form-label">图片</view>
  <view class="upload-grid">
    <view wx:for="{{images}}" wx:key="*this" class="upload-item">
      <image src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="previewImage" />
      <view class="upload-remove" data-index="{{index}}" catchtap="removeImage">×</view>
    </view>
    <view class="upload-add" bindtap="chooseImages">
      <text style="font-size: 48rpx; line-height: 1;">＋</text>
      <text>添加图片</text>
    </view>
  </view>

  <view class="form-label">微信号（选填，不进正文）</view>
  <view class="field">
    <input
      maxlength="30"
      type="text"
      placeholder="例如：campus_helper"
      value="{{contactValue}}"
      bindinput="onContactInput"
    />
  </view>
  <view class="contact-tip">
    需要对接时再填，不填也能发。请勿写进正文或图片。
  </view>

  <view class="switch-row" style="margin-top: 28rpx;">
    <view>
      <view class="section-title">匿名发布</view>
      <view class="meta">其他人将看不到你的昵称</view>
    </view>
    <switch checked="{{anonymous}}" color="#2F7DFF" bindchange="onAnonymousChange" />
  </view>

  <button class="btn-primary submit-btn" bindtap="onSubmit" disabled="{{submitting}}" loading="{{submitting}}">{{submitting ? '发布中' : '发布'}}</button>
  </block>
  <privacy-popup />
</view>
