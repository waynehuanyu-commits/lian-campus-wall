<view class="page publish-page">
  <view wx:if="{{blocked}}" class="empty">
    <view class="empty-title">{{blockTitle}}</view>
    <view>{{blockDesc}}</view>
    <button wx:if="{{blockAction === 'login'}}" class="btn-primary submit-btn" bindtap="goLogin">去开通发言</button>
    <button wx:elif="{{blockAction === 'auth'}}" class="btn-primary submit-btn" bindtap="goAuth">去认证学校</button>
  </view>

  <block wx:else>
  <view class="pub-card">
    <view class="pub-label">主题</view>
    <view class="topic-grid">
      <view
        wx:for="{{topics}}"
        wx:key="*this"
        class="topic-chip {{(tagMode === 'other' && item === otherTopic) || (tagMode !== 'other' && tag === item) ? 'active' : ''}}"
        data-name="{{item}}"
        bindtap="onTopicTap"
      >{{item}}</view>
    </view>
    <view wx:if="{{tagMode === 'other'}}" class="topic-field">
      <input
        maxlength="8"
        placeholder="输入自己的话题，最多 8 个字"
        placeholder-class="pub-ph"
        value="{{customTag}}"
        focus="{{otherFocus}}"
        bindinput="onCustomInput"
      />
    </view>
  </view>

  <view class="pub-card pub-editor">
    <input class="pub-title" placeholder="一句话讲清楚主题（选填）" placeholder-class="pub-ph" value="{{title}}" bindinput="onTitleInput" />
    <view class="pub-divider"></view>
    <textarea
      class="pub-body"
      placeholder="分享新鲜事、提问、组队都可以"
      placeholder-class="pub-ph"
      value="{{content}}"
      auto-height
      bindinput="onContentInput"
    />
    <view class="upload-grid">
      <view wx:for="{{images}}" wx:key="*this" class="upload-item">
        <image src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="previewImage" />
        <view class="upload-remove" data-index="{{index}}" catchtap="removeImage">×</view>
      </view>
      <view class="upload-add" bindtap="chooseImages">
        <view class="upload-add-ic"></view>
        <text>添加图片</text>
      </view>
    </view>
  </view>

  <view class="pub-card pub-list">
    <view class="pub-row">
      <view class="pub-row-copy">
        <text class="pub-row-title">匿名发布</text>
        <text class="pub-row-desc">其他人将看不到你的昵称</text>
      </view>
      <switch checked="{{anonymous}}" color="#0A5CFF" bindchange="onAnonymousChange" />
    </view>
  </view>

  <view class="pub-submit-bar">
    <button class="pub-submit" bindtap="onSubmit" disabled="{{submitting}}" loading="{{submitting}}">{{submitting ? '发布中' : '发布'}}</button>
  </view>
  </block>
  <privacy-popup />
</view>
