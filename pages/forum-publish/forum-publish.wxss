.publish-page {
  padding: 8rpx 32rpx 80rpx;
  background: #fff;
  min-height: 100vh;
  box-sizing: border-box;
}

.topic-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.topic-chip {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 26rpx;
  line-height: 1;
}

.topic-chip.active {
  background: #eaf2ff;
  color: #2f7dff;
  font-weight: 600;
}

.topic-custom-label {
  margin-top: 28rpx;
}

.topic-field {
  margin-top: 0;
  border: 2rpx solid transparent;
}

.topic-field.active {
  border-color: #2f7dff;
  background: #fff;
}

.field textarea {
  min-height: 220rpx;
  line-height: 1.6;
}

.submit-btn {
  margin-top: 48rpx;
  width: 100%;
}

.contact-tip {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #f5f6f8;
  color: #8c8c8c;
  font-size: 22rpx;
  line-height: 1.65;
}
