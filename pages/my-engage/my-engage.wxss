.sub-page {
  min-height: 100vh;
  background: #f3f6fb;
  padding: 20rpx 0 calc(40rpx + env(safe-area-inset-bottom));
}

.segment {
  margin: 0 24rpx 18rpx;
  display: flex;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 18rpx;
  padding: 6rpx;
  box-sizing: border-box;
}

.seg {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #9a8a90;
  padding: 0 8rpx;
  white-space: nowrap;
}

.engage-author {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #2f7dff;
  font-weight: 650;
}

.seg.active {
  background: linear-gradient(145deg, #6aadff 0%, #2f7dff 100%);
  color: #fff;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(47, 125, 255, 0.25);
}

.list {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.mini {
  margin-bottom: 0;
  padding: 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 28rpx rgba(30, 70, 140, 0.05);
}

.mini-title {
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 720;
  color: #1f2329;
}

.mini-content {
  margin-top: 8rpx;
  margin-bottom: 4rpx;
  color: #6f5f66;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.engage-target {
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2329;
}

.engage-reply {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #2f7dff;
}

.engage-del {
  display: inline-flex;
  margin-top: 12rpx;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #e11d48;
  font-size: 22rpx;
  font-weight: 650;
  background: #fff1f2;
  line-height: 48rpx;
}
