<view class="app-backdrop"></view>
<view class="page sub-page">
  <view class="segment">
    <view
      wx:for="{{tabs}}"
      wx:key="id"
      class="seg {{tab === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onTabTap"
    >{{item.name}}</view>
  </view>

  <view wx:if="{{loading}}" class="page-loading">
    <view class="page-loading-dot"></view>
    <view>加载中…</view>
  </view>

  <view wx:elif="{{loadError}}" class="empty">
    <view class="empty-title">加载失败</view>
    <view>{{loadError}}</view>
  </view>

  <block wx:elif="{{tab === 'liked'}}">
    <view wx:if="{{likedList.length}}" class="list">
      <view
        wx:for="{{likedList}}"
        wx:key="uniq"
        class="feed-item mini"
        data-id="{{item.id}}"
        data-type="{{item.type}}"
        bindtap="goPost"
      >
        <view class="row between">
          <view class="tag">{{item.badge}}</view>
          <view class="meta">{{item.timeText}}</view>
        </view>
        <view class="mini-title">{{item.title}}</view>
        <view class="mini-content">{{item.content}}</view>
      </view>
    </view>
    <view wx:else class="empty">
      <view class="empty-title">还没有点赞</view>
      <view>看到喜欢的内容点个赞吧</view>
    </view>
  </block>

  <block wx:else>
    <view wx:if="{{commentList.length}}" class="list">
      <view
        wx:for="{{commentList}}"
        wx:key="id"
        class="feed-item mini"
        data-id="{{item.targetId}}"
        data-type="{{item.targetType}}"
        data-exists="{{item.postExists}}"
        bindtap="goPost"
      >
        <view class="row between">
          <view class="tag">{{item.postBadge}}</view>
          <view class="meta">{{item.timeText}}</view>
        </view>
        <view class="engage-target">我评论了 · {{item.postExists ? item.postTitle : '原帖已不可用'}}</view>
        <view wx:if="{{item.replyToName}}" class="engage-reply">回复 @{{item.replyToName}}</view>
        <view wx:if="{{item.content}}" class="mini-content">{{item.content}}</view>
        <view wx:elif="{{item.images.length}}" class="meta">[图片]</view>
        <view class="comment-reply-btn danger engage-del" data-id="{{item.id}}" catchtap="onDeleteComment">删除</view>
      </view>
    </view>
    <view wx:else class="empty">
      <view class="empty-title">还没有评论</view>
      <view>去帖子里留下第一条吧</view>
    </view>
  </block>
</view>
