.msg-page {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.conv-list {
  background: #fff;
}

.conv-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  position: relative;
}

.conv-row + .conv-row::before {
  content: '';
  position: absolute;
  left: 140rpx;
  right: 0;
  top: 0;
  height: 1rpx;
  background: #f0f2f5;
}

.conv-row-on {
  background: #f7f8fa;
}

.conv-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #eef1f6;
  flex-shrink: 0;
}

.conv-main {
  flex: 1;
  min-width: 0;
}

.conv-top,
.conv-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.conv-name {
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.conv-time {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #9aa3af;
}

.conv-bottom {
  margin-top: 8rpx;
}

.conv-preview {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #8a9199;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.conv-reddot {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ff2442;
}

.note-state {
  padding: 160rpx 48rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8a9199;
}
