<view class="msg-page">
  <view wx:if="{{loading}}" class="note-state">加载中</view>
  <view wx:elif="{{loadError}}" class="note-state">{{loadError}}</view>
  <view wx:elif="{{list.length}}" class="conv-list">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="conv-row"
      data-id="{{item.id}}"
      bindtap="goChat"
      hover-class="conv-row-on"
    >
      <image class="conv-avatar" src="{{item.peerAvatar}}" mode="aspectFill" />
      <view class="conv-main">
        <view class="conv-top">
          <view class="conv-name">{{item.peerName}}</view>
          <view class="conv-time">{{item.timeText}}</view>
        </view>
        <view class="conv-bottom">
          <view class="conv-preview">{{item.lastPreview || '暂无消息'}}</view>
          <view wx:if="{{item.hasUnread}}" class="conv-reddot"></view>
        </view>
      </view>
    </view>
  </view>
  <view wx:else class="note-state">暂无私信</view>
</view>
