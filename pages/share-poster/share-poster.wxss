.poster-page {
  min-height: 100vh;
  background: #F7F8FA;
  box-sizing: border-box;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.poster-state {
  padding: 180rpx 48rpx 0;
  text-align: center;
}

.poster-state-title {
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #121A2C;
}

.poster-state-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #858D9C;
  line-height: 1.5;
}

.poster-retry {
  display: inline-block;
  margin-top: 36rpx;
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  background: #0A5CFF;
  color: #fff;
  font-size: 28rpx;
  font-weight: 650;
}

.poster-scroll {
  height: calc(100vh - 180rpx - env(safe-area-inset-bottom));
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.poster-image {
  width: 100%;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 12rpx 32rpx rgba(10,42,122, 0.08);
}

.poster-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(247,249,252, 0.96);
  box-shadow: 0 -8rpx 24rpx rgba(10,42,122, 0.06);
}

.poster-tip {
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: #858D9C;
  text-align: center;
}

.poster-btns {
  display: flex;
  gap: 16rpx;
}

.poster-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.poster-btn.primary {
  background: #0A5CFF;
  color: #fff;
}

.poster-btn.ghost {
  background: #fff;
  color: #0A5CFF;
  border: 2rpx solid #D6E2FF;
}

.poster-btn.disabled {
  opacity: 0.55;
}

.poster-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 750px;
  height: 2000px;
}
