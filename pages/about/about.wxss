.about-page {
  min-height: 100vh;
  background: #f3f6fb;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.about-hero {
  padding: 48rpx 40rpx 36rpx;
}

.about-mark {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  font-weight: 650;
  color: rgba(31,102,229, 0.85);
}

.about-name {
  margin-top: 12rpx;
  font-size: 44rpx;
  font-weight: 760;
  color: #1f2329;
}

.about-tagline {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #7a8799;
}

.about-card {
  margin: 0 24rpx 16rpx;
  padding: 28rpx 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 40rpx rgba(30, 70, 140, 0.06);
}

.about-intro {
  font-size: 26rpx;
  color: #4a5568;
  line-height: 1.7;
}

.feature-item + .feature-item {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #eef2f8;
}

.feature-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2329;
}

.feature-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9a8a90;
  line-height: 1.5;
}

.nav-block {
  margin: 8rpx 24rpx 0;
  padding: 8rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 40rpx rgba(30, 70, 140, 0.06);
}

.nav-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 22rpx;
}

.nav-item-hover {
  background: #f3f7ff;
}

.nav-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}

.nav-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.nav-dot.legal {
  background: #5b8def;
  box-shadow: 0 0 0 8rpx rgba(91, 141, 239, 0.14);
}

.nav-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}

.nav-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9a8a90;
}

.nav-arrow {
  color: #d0c4c8;
  font-size: 36rpx;
  line-height: 1;
  font-weight: 300;
}

.about-foot {
  margin: 36rpx 40rpx 0;
  text-align: center;
  color: #b5a6ab;
  font-size: 22rpx;
}
