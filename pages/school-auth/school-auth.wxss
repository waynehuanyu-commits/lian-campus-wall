.publish-page {
  background: #f5f6f8;
  min-height: 100vh;
  padding-bottom: 80rpx;
}

.panel {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
}

.notice-text {
  margin-top: 12rpx;
  color: #8c8c8c;
  font-size: 24rpx;
  line-height: 1.7;
}

.lock-tag {
  font-size: 22rpx;
  color: #2f7dff;
  background: rgba(255, 59, 92, 0.08);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  font-weight: 600;
}

.lock-tag.ok {
  color: #07c160;
  background: rgba(7, 193, 96, 0.1);
}

.lock-tag.danger {
  color: #2f7dff;
  background: rgba(255, 59, 92, 0.08);
}

.locked-school {
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.pending-line {
  margin: 12rpx 0 8rpx;
  color: #333;
}

.rule-block {
  margin-top: 18rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f5f5f5;
}

.rule-title {
  font-size: 26rpx;
  font-weight: 650;
  color: #1a1a1a;
}

.danger-text {
  margin-top: 12rpx;
  color: #2f7dff;
}

.image-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}

.image-box,
.image-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
  background: #f5f6f8;
}

.image-box image {
  width: 100%;
  height: 100%;
}

.image-add {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b0b0b0;
  font-size: 48rpx;
  border: 2rpx dashed #d9d9d9;
}

.image-remove {
  position: absolute;
  top: 4rpx;
  right: 8rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 34rpx;
  font-size: 28rpx;
}

.submit-btn,
.change-btn {
  margin-top: 28rpx;
  width: 100%;
}

.chips {
  margin-top: 16rpx;
}
