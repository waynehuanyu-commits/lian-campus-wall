.auth-page {
  background: transparent;
  min-height: 100vh;
  padding: 20rpx 24rpx 80rpx;
  box-sizing: border-box;
}

.form-label.first {
  margin-top: 0;
}

.panel {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(10, 42, 122, 0.05);
}

.notice-text {
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.7;
}

.lock-tag {
  font-size: 22rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  font-weight: 600;
}

.lock-tag.ok {
  color: #07c160;
  background: rgba(7, 193, 96, 0.1);
}

.lock-tag.danger {
  color: var(--like);
  background: #ffeef1;
}

.locked-school {
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--ink);
}

.pending-line {
  margin: 12rpx 0 8rpx;
  color: #333;
}

.rule-block {
  margin-top: 18rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--line);
}

.rule-title {
  font-size: 26rpx;
  font-weight: 650;
  color: var(--ink);
}

.danger-text {
  margin-top: 12rpx;
  color: var(--like);
}

.image-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}

.image-box,
.image-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
  background: var(--paper);
}

.image-box image {
  width: 100%;
  height: 100%;
}

.image-add {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand);
  font-size: 48rpx;
  border: 2rpx dashed rgba(8,75,216, 0.25);
}

.image-remove {
  position: absolute;
  top: 4rpx;
  right: 8rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 34rpx;
  font-size: 28rpx;
}

.submit-btn,
.change-btn {
  margin-top: 28rpx;
  width: 100%;
}

.chips {
  margin-top: 16rpx;
}
