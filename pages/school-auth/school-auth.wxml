<view class="app-backdrop"></view>
<view class="page padded auth-page">
  <view wx:if="{{!locked}}" class="panel notice">
    <view class="section-title">学校认证</view>
    <view class="notice-text">发言、评论和查看联系方式前需认证学校。请填写真实学校全称。提交后不可修改。</view>
  </view>

  <block wx:if="{{locked}}">
    <view class="panel locked-card">
      <view class="row between">
        <view class="section-title">已认证学校</view>
        <view class="lock-tag">已锁定</view>
      </view>
      <view class="locked-school">{{schoolText}}</view>
      <view class="meta" wx:if="{{submittedText}}">认证时间 {{submittedText}}</view>
      <view class="notice-text" style="margin-top: 16rpx;">学校信息提交后不可修改，请确认后再提交。</view>
    </view>

    <view class="panel student-card">
      <view class="row between">
        <view class="section-title">学生身份认证</view>
        <view class="lock-tag {{studentStatusClass}}">{{studentStatusText}}</view>
      </view>
      <view class="notice-text">在基础学校认证之上，可进一步提交学生身份材料。通过后个人主页会显示「学生已认证」。</view>

      <view class="rule-block">
        <view class="rule-title">所需材料（选填）</view>
        <view class="notice-text">可上传学生证个人信息页，或盖章的在读证明 / 录取通知书。也可先不传图，仅填写说明。有照片时请遮挡证件号后六位与住址，保留姓名、学校、有效期。</view>
      </view>
      <view class="rule-block">
        <view class="rule-title">审核方式</view>
        <view class="notice-text">管理员人工核对；上传材料的一般更快。通常 1–3 个工作日。</view>
      </view>
      <view class="rule-block">
        <view class="rule-title">隐私保护</view>
        <view class="notice-text">材料仅用于身份核验，不出现在帖子、评论或公开主页。仅管理员可在审核后台查看。</view>
      </view>

      <view wx:if="{{studentAuthStatus === 'rejected' && studentReviewNote}}" class="meta danger-text">未通过原因：{{studentReviewNote}}</view>

      <block wx:if="{{studentAuthStatus !== 'approved' && studentAuthStatus !== 'pending'}}">
        <view class="form-label">证明照片（选填，最多 3 张）</view>
        <view class="image-row">
          <view wx:for="{{studentImages}}" wx:key="*this" class="image-box">
            <image src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="previewStudentImage" />
            <view class="image-remove" data-index="{{index}}" catchtap="removeStudentImage">×</view>
          </view>
          <view wx:if="{{studentImages.length < 3}}" class="image-add" bindtap="chooseStudentImage">＋</view>
        </view>
        <view class="form-label">补充说明（选填）</view>
        <view class="field">
          <input maxlength="80" placeholder="如：大二在读，证件有效期至 2027" value="{{studentNote}}" bindinput="onStudentNoteInput" />
        </view>
        <button class="btn-primary submit-btn" bindtap="onSubmitStudent">提交学生认证（可不传照片）</button>
      </block>

      <view wx:elif="{{studentAuthStatus === 'pending'}}" class="notice-text" style="margin-top: 16rpx;">材料已提交，请等待管理员审核。</view>
      <view wx:else class="notice-text" style="margin-top: 16rpx;">你已通过学生身份认证。学校标签仍默认隐藏，可在「我的」自行开启展示。</view>
    </view>
  </block>

  <block wx:else>
    <view class="panel">
    <view class="form-label first">学校名称</view>
    <view class="field">
      <input maxlength="40" placeholder="请输入学校全称" value="{{schoolName}}" bindinput="onSchoolInput" />
    </view>

    <view class="form-label">校区（选填）</view>
    <view class="field">
      <input maxlength="20" placeholder="如：主校区 / 东校区" value="{{schoolCampus}}" bindinput="onCampusInput" />
    </view>
    </view>

    <view class="panel notice">
      <view class="rule-title">注意</view>
      <view class="notice-text">提交后学校信息不可修改。学校标签默认不在个人主页展示，可在「我的」自行开启。</view>
    </view>

    <button class="btn-primary submit-btn" bindtap="onSubmit">提交并锁定</button>
  </block>
  <privacy-popup />
</view>
