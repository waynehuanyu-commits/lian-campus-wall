.page {
  background: #f3f6fb;
}

.home-page .top-bar {
  position: static;
}

.home-search-text,
.compact-search-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 28rpx;
  color: #333;
}

.home-search-text.muted,
.compact-search-text.muted {
  color: #999;
}

.compact-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 24rpx;
  background: #eef5ff;
  border-bottom: 1rpx solid rgba(47, 125, 255, 0.08);
  box-shadow: none;
}

.compact-sort {
  flex-shrink: 0;
  margin: 0;
}

.compact-search {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.compact-topic {
  flex-shrink: 0;
  max-width: 180rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 24rpx;
  font-weight: 500;
}

.compact-topic.active {
  color: #2f7dff;
  background: #e7f1ff;
}

.home-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  background: rgba(0, 0, 0, 0.4);
}

.search-sheet,
.topic-sheet {
  margin: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #fff;
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
}

.search-actions {
  display: flex;
  justify-content: flex-end;
  gap: 28rpx;
  margin-top: 20rpx;
  font-size: 28rpx;
}

.search-cancel {
  color: #999;
}

.search-ok {
  color: #2f7dff;
  font-weight: 600;
}

.topic-option {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #333;
  border-bottom: 1rpx solid #f0f0f0;
  text-align: center;
}

.topic-option.active {
  color: #2f7dff;
  font-weight: 600;
}

.topic-custom-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
}

.topic-custom-row input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f5f6f8;
  font-size: 28rpx;
}

.topic-custom-ok {
  color: #2f7dff;
  font-size: 28rpx;
  font-weight: 600;
}

.home-tabs-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
  min-width: 0;
}

.tabs-scroll {
  flex: 1;
  width: 0;
  height: 72rpx;
  white-space: nowrap;
  margin-top: 0;
}

/* 横向滚动要用 inline-block 撑开内容宽；全局 .tabs-line{display:flex} 会裁掉末尾 */
.home-page .home-tabs-line,
.home-tabs-line {
  display: inline-block !important;
  height: 72rpx;
  padding: 0 16rpx 0 0 !important;
  box-sizing: border-box;
  white-space: nowrap;
  font-size: 0;
  background: transparent;
}

.home-page .home-tab-item,
.home-tab-item {
  display: inline-block !important;
  vertical-align: middle;
  margin-right: 36rpx;
  font-size: 28rpx;
  white-space: nowrap;
}

.home-tab-custom-pin {
  flex-shrink: 0;
  max-width: 180rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #2f7dff;
  font-size: 24rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-tab-custom-pin.active {
  background: #2f7dff;
  color: #fff;
}

.home-custom-field {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
  padding: 0 4rpx;
  min-width: 0;
}

.home-custom-hash {
  color: #2f7dff;
  font-size: 30rpx;
  font-weight: 700;
}

.home-custom-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #f5f6f8;
  font-size: 28rpx;
  color: #1f2329;
}

.home-custom-ok {
  flex-shrink: 0;
  color: #2f7dff;
  font-size: 28rpx;
  font-weight: 600;
}

.home-custom-cancel {
  flex-shrink: 0;
  color: #999;
  font-size: 26rpx;
}

.feed-end {
  padding: 28rpx 24rpx 48rpx;
  text-align: center;
  color: #b0b4ba;
  font-size: 24rpx;
}

.sort-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
  height: 56rpx;
  margin: 4rpx 0 0;
  padding: 0;
  background: transparent;
  box-shadow: none;
}

.sort-item {
  min-width: 0;
  height: 56rpx;
  padding: 0;
  border-radius: 0;
  font-size: 28rpx;
  color: #999;
  font-weight: 400;
  display: flex;
  align-items: center;
  background: transparent;
  box-shadow: none;
}

.sort-item.active {
  color: #2f7dff;
  font-weight: 700;
  background: transparent;
  box-shadow: none;
}

.sort-item.active::after {
  display: none;
}

.author-meta {
  min-width: 0;
  flex: 1;
}

.home-page .feed-head .author-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.post-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #333;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.post-content {
  color: #666;
  font-size: 28rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.post-content.open {
  display: block;
  -webkit-line-clamp: unset;
  overflow: visible;
}
