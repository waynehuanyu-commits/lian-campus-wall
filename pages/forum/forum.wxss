.page {
  background: transparent;
}

.home-page .top-bar {
  position: static;
}

.home-search-text,
.compact-search-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 28rpx;
  color: var(--ink);
}

.home-search-text.muted,
.compact-search-text.muted {
  color: var(--ink-4);
}

.compact-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 24rpx;
  background: #eef5ff;
  border-bottom: 1rpx solid rgba(47, 125, 255, 0.08);
  box-shadow: none;
}

.compact-sort {
  flex-shrink: 0;
  margin: 0;
}

.compact-search {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.compact-topic {
  flex-shrink: 0;
  max-width: 180rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 24rpx;
  font-weight: 500;
}

.compact-topic.active {
  color: #2f7dff;
  background: #e7f1ff;
}

.home-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  background: rgba(0, 0, 0, 0.4);
}

.search-sheet,
.topic-sheet {
  margin: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #fff;
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
}

.search-actions {
  display: flex;
  justify-content: flex-end;
  gap: 28rpx;
  margin-top: 20rpx;
  font-size: 28rpx;
}

.search-cancel {
  color: #999;
}

.search-ok {
  color: #2f7dff;
  font-weight: 600;
}

.topic-option {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #333;
  border-bottom: 1rpx solid #f0f0f0;
  text-align: center;
}

.topic-option.active {
  color: #2f7dff;
  font-weight: 600;
}

.topic-custom-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
}

.topic-custom-row input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f5f6f8;
  font-size: 28rpx;
}

.topic-custom-ok {
  color: #2f7dff;
  font-size: 28rpx;
  font-weight: 600;
}

.home-tabs-row {
  position: sticky;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 0;
  padding: 12rpx 24rpx 12rpx 32rpx;
  min-width: 0;
  background: rgba(238, 243, 252, 0.86);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
}

/* 分类过多时右侧渐隐，提示可横滑 */
.home-tabs-row .tabs-scroll {
  -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 82%, transparent 100%);
  mask-image: linear-gradient(90deg, #000 0%, #000 82%, transparent 100%);
}

.tabs-scroll {
  flex: 1;
  width: 0;
  height: 72rpx;
  white-space: nowrap;
  margin-top: 0;
}

/* 横向滚动要用 inline-block 撑开内容宽；全局 .tabs-line{display:flex} 会裁掉末尾 */
.home-page .home-tabs-line,
.home-tabs-line {
  display: inline-block !important;
  height: 72rpx;
  padding: 0 16rpx 0 0 !important;
  box-sizing: border-box;
  white-space: nowrap;
  font-size: 0;
  background: transparent;
}

.home-page .home-tab-item,
.home-tab-item {
  display: inline-block !important;
  vertical-align: middle;
  margin-right: 40rpx;
  font-size: 28rpx;
  white-space: nowrap;
}

.home-tab-custom-pin {
  flex-shrink: 0;
  max-width: 180rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #2f7dff;
  font-size: 24rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-tab-custom-pin.active {
  background: #2f7dff;
  color: #fff;
}

.home-custom-field {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
  padding: 0 4rpx;
  min-width: 0;
}

.home-custom-hash {
  color: #2f7dff;
  font-size: 30rpx;
  font-weight: 700;
}

.home-custom-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #f5f6f8;
  font-size: 28rpx;
  color: #1f2329;
}

.home-custom-ok {
  flex-shrink: 0;
  color: #2f7dff;
  font-size: 28rpx;
  font-weight: 600;
}

.home-custom-cancel {
  flex-shrink: 0;
  color: #999;
  font-size: 26rpx;
}

.feed-end {
  padding: 32rpx 24rpx 56rpx;
  text-align: center;
  color: var(--ink-4);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.sort-row {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 0;
  height: 52rpx;
  margin: 0;
  padding: 4rpx;
  border-radius: 999rpx;
  background: rgba(18, 26, 44, 0.05);
  box-shadow: none;
  box-sizing: border-box;
}

.sort-item {
  min-width: 0;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  font-weight: 500;
  display: flex;
  align-items: center;
  background: transparent;
  box-shadow: none;
}

.sort-item.active {
  color: var(--ink);
  font-weight: 700;
  background: var(--surface);
  box-shadow: 0 2rpx 6rpx rgba(18, 26, 44, 0.08);
}

.sort-item.active::after {
  display: none;
}

.author-meta {
  min-width: 0;
  flex: 1;
}

.home-page .feed-head .author-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.post-title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.45;
  color: var(--ink);
  margin-bottom: 6rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.post-content {
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 6;
  overflow: hidden;
}

.post-content.open {
  display: block;
  -webkit-line-clamp: unset;
  overflow: visible;
}

.masthead {
  position: sticky;
  top: 0;
  z-index: 31;
  padding-left: 32rpx;
  padding-bottom: 0;
  background: rgba(233, 240, 255, 0.86);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
}

.masthead-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-sizing: border-box;
}


.masthead-name {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 4rpx;
  line-height: 1;
}



.masthead-logo {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(10, 92, 255, 0.18);
}

.search-bar-on {
  background: #fff;
}

.feed-item {
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.feed-item-on {
  transform: scale(0.985);
  box-shadow: 0 2rpx 10rpx rgba(10, 42, 122, 0.04);
}

/* 首屏骨架：卡片轮廓 + 扫光 */
.sk {
  position: relative;
  overflow: hidden;
  border-radius: 8rpx;
  background: #e9eef6;
}

.sk::after {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: -60%;
  width: 60%;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.75) 50%, rgba(255, 255, 255, 0) 100%);
  animation: sk-sweep 1.2s ease-in-out infinite;
}

@keyframes sk-sweep {
  0% { transform: translateX(0); }
  100% { transform: translateX(270%); }
}

.sk-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.sk-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
}

.sk-name {
  width: 180rpx;
  height: 26rpx;
}

.sk-line {
  height: 26rpx;
  margin-bottom: 16rpx;
}

.sk-line.short {
  width: 56%;
  margin-bottom: 4rpx;
}

.search-clear {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  background: var(--ink-4);
  position: relative;
}

.search-clear::before,
.search-clear::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18rpx;
  height: 3rpx;
  margin: -1.5rpx 0 0 -9rpx;
  border-radius: 2rpx;
  background: #fff;
  transform: rotate(45deg);
}

.search-clear::after {
  transform: rotate(-45deg);
}
