.page {
  background: linear-gradient(180deg, #e7f1ff 0%, #f3f6fb 420rpx);
}

.tabs-scroll {
  width: 100%;
  height: 72rpx;
  white-space: nowrap;
}

.tabs-line {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  height: 72rpx;
  min-width: 100%;
  box-sizing: border-box;
  gap: 32rpx;
}

.sort-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  height: 48rpx;
  margin: 4rpx 0 4rpx;
  padding: 0;
  background: transparent;
  box-shadow: none;
}

.sort-item {
  min-width: 0;
  height: 48rpx;
  padding: 0;
  border-radius: 0;
  font-size: 26rpx;
  color: #8a9199;
  font-weight: 500;
  display: flex;
  align-items: center;
  background: transparent;
  box-shadow: none;
}

.sort-item.active {
  color: #2f7dff;
  font-weight: 700;
  background: transparent;
  box-shadow: none;
}

.sort-item.active::after {
  display: none;
}

.author-meta {
  min-width: 0;
  flex: 1;
}

.author-name {
  font-size: 28rpx;
  font-weight: 650;
  color: #1f2329;
}

.contact-hint {
  display: none;
}

.post-title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #111111;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.post-content {
  color: #868686;
  font-size: 28rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.post-content.open {
  display: block;
  -webkit-line-clamp: unset;
  overflow: visible;
}

.hot-entry {
  position: relative;
  overflow: hidden;
  margin: 18rpx 24rpx 0;
  padding: 26rpx 28rpx 20rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #f5f8ff 0%, #e3eeff 48%, #eef5ff 100%);
  border: 1rpx solid rgba(47, 125, 255, 0.12);
  box-shadow: 0 14rpx 34rpx rgba(47, 125, 255, 0.08);
}

.hot-entry::before {
  content: "";
  position: absolute;
  right: -40rpx;
  top: -50rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(47, 125, 255, 0.1);
  pointer-events: none;
}

.hot-entry-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.hot-entry-label {
  font-size: 20rpx;
  color: #2f7dff;
  font-weight: 750;
  letter-spacing: 2rpx;
}

.hot-entry-title {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 760;
  color: #2a2426;
}

.hot-entry-right {
  flex-shrink: 0;
  color: #2f7dff;
  font-size: 24rpx;
  font-weight: 700;
}

.hot-preview {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  padding-top: 8rpx;
}

.hot-preview-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  color: #4a3f44;
  font-size: 24rpx;
  line-height: 1.4;
  border-bottom: 1rpx solid rgba(47, 125, 255, 0.06);
}

.hot-preview-item:last-child {
  border-bottom: none;
}

.hot-preview-rank {
  width: 32rpx;
  flex-shrink: 0;
  color: #2f7dff;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.hot-preview-type {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(47, 125, 255, 0.12);
  font-size: 20rpx;
  color: #2f7dff;
  font-weight: 650;
}

.hot-preview-type.wall {
  background: rgba(90, 70, 80, 0.08);
  color: #7a6870;
}

.hot-preview-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #5c4a52;
}
