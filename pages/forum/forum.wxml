<view class="page home-page">
  <view class="top-bar home-top">
    <view class="search-bar" bindtap="openSearch">
      <text class="search-icon">⌕</text>
      <text class="home-search-text {{keyword ? '' : 'muted'}}">{{keyword || '搜索话题、标题或正文'}}</text>
    </view>
    <view class="home-tabs-row">
      <scroll-view class="tabs-scroll" scroll-x show-scrollbar="{{false}}">
        <view class="tabs-line home-tabs-line">
          <view
            wx:for="{{topics}}"
            wx:key="*this"
            class="tab-line home-tab-item {{topic === item ? 'active' : ''}}"
            data-name="{{item}}"
            bindtap="onTopicTap"
          >{{item}}</view>
        </view>
      </scroll-view>
    </view>
    <view class="sort-row">
      <view
        wx:for="{{sortOptions}}"
        wx:key="id"
        class="sort-item {{sort === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onSortTap"
      >{{item.name}}</view>
    </view>
  </view>

  <view wx:if="{{weeklyHot && weeklyHot.preview.length}}" class="hot-board">
    <view class="hot-board-head" bindtap="goWeeklyHot">
      <view class="hot-mark">精选</view>
      <view class="hot-board-copy">
        <text class="hot-board-title">每周精选</text>
        <text class="hot-board-sub">{{weeklyHot.subtitle || '本周校园好帖'}}</text>
      </view>
      <text class="hot-board-more">全部</text>
    </view>
    <view
      wx:for="{{weeklyHot.preview}}"
      wx:key="previewKey"
      class="hot-line"
      data-id="{{item.contentId}}"
      data-type="{{item.contentType}}"
      catchtap="goHotItem"
    >
      <text class="hot-line-rank {{item.rank === 1 ? 'top1' : (item.rank === 2 ? 'top2' : (item.rank === 3 ? 'top3' : ''))}}">{{item.rank}}</text>
      <text class="hot-line-title">{{item.title || item.oneLiner}}</text>
      <text class="hot-line-go">›</text>
    </view>
  </view>
  <view wx:if="{{!canSpeak && speakCode === 'NEED_LOGIN'}}" class="guest-tip" bindtap="goLogin">
    <text>{{guestTip}}</text>
    <text class="action">去开通</text>
  </view>
  <view wx:elif="{{!canSpeak && speakCode === 'NEED_AUTH'}}" class="guest-tip" bindtap="goAuth">
    <text>{{guestTip}}</text>
    <text class="action">去认证</text>
  </view>
  <view wx:elif="{{!canSpeak && guestTip}}" class="guest-tip">
    <text>{{guestTip}}</text>
  </view>

  <view wx:if="{{loadError}}" class="empty">
    <view class="empty-title">{{loadError}}</view>
    <view>下拉页面可重新加载</view>
  </view>

  <view wx:elif="{{posts.length}}" class="feed">
    <view
      wx:for="{{posts}}"
      wx:key="uniq"
      class="feed-item feed-item-v2"
      data-id="{{item.id}}"
      data-type="{{item.contentType}}"
      data-key="{{item.feedKey}}"
      bindtap="goDetail"
    >
      <!-- 头像必须在最上方：左头像 + 昵称 + 右时间 -->
      <view class="feed-head">
        <image
          class="avatar feed-avatar"
          src="{{item.authorAvatar}}"
          mode="aspectFill"
          catchtap="onAuthorTap"
          data-userid="{{item.authorId}}"
          data-anonymous="{{item.anonymous}}"
        />
        <view class="feed-head-main">
          <text
            class="author-name"
            catchtap="onAuthorTap"
            data-userid="{{item.authorId}}"
            data-anonymous="{{item.anonymous}}"
          >{{item.authorName || '黎安人'}}</text>
          <text class="meta">{{item.timeText}}</text>
        </view>
      </view>
      <view wx:if="{{item.showTitle}}" class="post-title"><text wx:if="{{item.pinned}}" class="pin-tag">置顶</text><text wx:if="{{item.official}}" class="pin-tag official">官方</text>{{item.title}}</view>
      <view wx:elif="{{item.pinned || item.official}}" class="post-title post-title-flags"><text wx:if="{{item.pinned}}" class="pin-tag">置顶</text><text wx:if="{{item.official}}" class="pin-tag official">官方</text></view>
      <view wx:if="{{item.bodyText}}" class="post-content {{item.bodyOpen ? 'open' : ''}}">{{item.bodyText}}</view>
      <text wx:if="{{item.bodyLong}}" class="body-more" catchtap="toggleBody" data-id="{{item.id}}" data-type="{{item.contentType}}">{{item.bodyOpen ? '收起' : '展开'}}</text>
      <view wx:if="{{item.images && item.images.length}}" class="image-grid thumbs {{item.images.length > 1 ? 'multi' : 'single'}}">
        <image
          wx:for="{{item.images}}"
          wx:for-item="img"
          wx:for-index="imgIndex"
          wx:key="*this"
          src="{{img}}"
          mode="aspectFill"
          lazy-load
          data-postid="{{item.id}}"
          data-type="{{item.contentType}}"
          data-index="{{imgIndex}}"
          catchtap="previewImage"
        />
      </view>
      <view class="feed-foot">
        <view class="feed-stats" catchtap="preventBubble">
          <view class="feed-foot-left">
            <view wx:if="{{item.displayTag}}" class="feed-tag-pill">
              <text class="feed-tag-hash">#</text>
              <text>{{item.displayTag}}</text>
            </view>
            <text wx:if="{{item.viewCount > 0}}" class="feed-views">{{item.viewCount}}次围观</text>
          </view>
          <view class="stat-row">
            <view
              class="engage-item {{item.liked ? 'liked' : ''}}"
              catchtap="onLike"
              data-id="{{item.id}}"
              data-type="{{item.contentType}}"
            >
              <view class="engage-ic engage-ic-heart"></view>
              <text class="engage-num">{{item.likeCount}}</text>
            </view>
            <view
              class="engage-item"
              catchtap="goDetail"
              data-id="{{item.id}}"
              data-type="{{item.contentType}}"
              data-key="{{item.feedKey}}"
            >
              <view class="engage-ic engage-ic-comment"></view>
              <text class="engage-num">{{item.commentCount}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="feed-end">{{loadingMore ? '正在加载更早的帖子' : (hasMore ? '上拉加载更多' : '没有更多了 · 共' + posts.length + '条')}}</view>
  </view>

  <view wx:elif="{{loading}}" class="empty">
    <view class="empty-title">正在加载</view>
  </view>

  <view wx:elif="{{!loading}}" class="empty">
    <view class="empty-title">{{topic === '官方' ? '还没有官方帖子' : '还没有帖子'}}</view>
    <view>换个主题，或发第一条吧</view>
  </view>

  <view class="fab" bindtap="goPublish" hover-class="fab-hover">
    <view class="fab-icon">
      <text class="fab-plus">＋</text>
      <text class="fab-heart">♥</text>
    </view>
    <text class="fab-text">发帖</text>
  </view>
</view>

<view wx:if="{{searchOpen}}" class="home-mask" bindtap="cancelSearch">
  <view class="search-sheet" catchtap="preventBubble">
    <view class="search-bar">
      <text class="search-icon">⌕</text>
      <input
        focus
        placeholder="搜索话题、标题或正文"
        placeholder-class="muted"
        value="{{keywordDraft}}"
        confirm-type="search"
        bindinput="onDraftInput"
        bindconfirm="confirmSearch"
      />
    </view>
    <view class="search-actions">
      <text class="search-cancel" bindtap="cancelSearch">取消</text>
      <text class="search-ok" bindtap="confirmSearch">搜索</text>
    </view>
  </view>
</view>

