@import "../../styles/detail-unified.wxss";

.status-tag {
  display: inline-flex;
  align-items: center;
  margin-left: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 650;
  vertical-align: middle;
}

.status-open {
  color: #1f7a4c;
  background: #e8f7ef;
}

.status-received {
  color: #b45309;
  background: #fff4e5;
}

.status-done {
  color: #0A5CFF;
  background: #E9EFFF;
}

.status-closed {
  color: #5E6678;
  background: #F1F3F6;
}

.status-panel {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #F7F8FA;
}

.status-panel-title {
  font-size: 24rpx;
  color: #5E6678;
  margin-bottom: 12rpx;
}

.status-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.status-action {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #3B4458;
  background: #fff;
  border: 1rpx solid #E6E9EE;
}

.status-action.active {
  color: #0A5CFF;
  border-color: #7FA6FF;
  background: #F3F6FF;
  font-weight: 650;
}

.ride-line {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #3B4458;
}

.detail-summary {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #3B4458;
  line-height: 1.55;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(18,26,44, 0.42);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 16rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #E6E9EE;
  margin: 0 auto 20rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #121A2C;
  margin-bottom: 16rpx;
}

.sheet-label {
  font-size: 24rpx;
  color: #858D9C;
}

.sheet-value {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #121A2C;
  word-break: break-all;
}

.sheet-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #858D9C;
  line-height: 1.55;
}

.sheet-btn {
  margin-top: 24rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #0A5CFF;
  color: #fff;
  font-size: 30rpx;
  font-weight: 650;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-btn.disabled {
  opacity: 0.55;
}

.sheet-btn-secondary {
  background: #F3F6FF;
  color: #0A5CFF;
}

.sheet-cancel {
  margin-top: 12rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #858D9C;
  font-size: 28rpx;
}

.feedback-reasons {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.feedback-chip {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #F1F3F6;
  color: #3B4458;
  font-size: 24rpx;
}

.feedback-chip.on {
  background: #E9EFFF;
  color: #0A5CFF;
  font-weight: 650;
}

.feedback-note {
  margin-top: 16rpx;
  width: 100%;
  min-height: 140rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #F1F3F6;
  box-sizing: border-box;
  font-size: 26rpx;
}
