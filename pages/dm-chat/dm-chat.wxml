<view class="chat-page">
  <scroll-view
    class="chat-scroll"
    scroll-y
    scroll-into-view="{{scrollInto}}"
    scroll-with-animation
  >
    <view wx:if="{{!messages.length}}" class="chat-empty">打个招呼吧</view>
    <view
      wx:for="{{messages}}"
      wx:key="id"
      id="m-{{item.id}}"
      class="bubble-row {{item.mine ? 'mine' : 'peer'}}"
    >
      <image
        wx:if="{{!item.mine}}"
        class="bubble-avatar"
        src="{{peerAvatar}}"
        mode="aspectFill"
      />
      <view class="bubble-col">
        <view wx:if="{{item.content}}" class="bubble" data-content="{{item.content}}" bindlongpress="onCopy">
          <text class="bubble-text" selectable>{{item.content}}</text>
        </view>
        <view wx:if="{{item.images.length}}" class="bubble-images">
          <image
            wx:for="{{item.images}}"
            wx:for-item="img"
            wx:for-index="imgIndex"
            wx:key="*this"
            class="bubble-image"
            src="{{img}}"
            mode="aspectFill"
            data-id="{{item.id}}"
            data-index="{{imgIndex}}"
            bindtap="previewImage"
          />
        </view>
        <view wx:if="{{item.held}}" class="bubble-held">审核中，对方暂时看不到</view>
        <view wx:if="{{item.timeText}}" class="bubble-time">{{item.timeText}}</view>
      </view>
      <image
        wx:if="{{item.mine}}"
        class="bubble-avatar"
        src="{{myAvatar}}"
        mode="aspectFill"
      />
    </view>
    <view id="chat-bottom" class="chat-bottom"></view>
  </scroll-view>

  <view class="chat-composer">
    <view wx:if="{{draftImages.length}}" class="chat-drafts">
      <view wx:for="{{draftImages}}" wx:key="*this" class="chat-draft">
        <image src="{{item}}" mode="aspectFill" />
        <view class="chat-draft-x" data-index="{{index}}" catchtap="removeDraftImage">×</view>
      </view>
    </view>
    <view class="chat-composer-row">
      <view class="chat-photo" bindtap="chooseImages"></view>
      <textarea
        class="chat-input"
        value="{{draft}}"
        placeholder="友善沟通，理性交流"
        placeholder-class="ph"
        auto-height
        maxlength="2000"
        confirm-type="send"
        bindinput="onDraftInput"
        bindconfirm="onSend"
      />
      <view class="chat-send {{submitting || (!draft && !draftImages.length) ? 'disabled' : ''}}" bindtap="onSend">发送</view>
    </view>
  </view>
  <privacy-popup />
</view>
