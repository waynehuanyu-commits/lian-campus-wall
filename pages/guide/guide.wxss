@import "../../styles/guide-cover.wxss";

.guide-page {
  padding-bottom: 200rpx;
}

.masthead {
  position: sticky;
  top: 0;
  z-index: 31;
  padding-left: 32rpx;
  background: rgba(233, 240, 255, 0.86);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
}

.masthead-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-sizing: border-box;
}

.masthead-logo {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(10, 92, 255, 0.18);
}

.masthead-name {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 4rpx;
  line-height: 1;
}

/* 分类：吸顶、可横滑，右侧渐隐提示还有 */
.gd-tabs {
  position: sticky;
  z-index: 30;
  padding: 8rpx 0 8rpx 32rpx;
  background: rgba(238, 243, 252, 0.86);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
}

.gd-tabs-scroll {
  width: 100%;
  height: 72rpx;
  white-space: nowrap;
  -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 86%, transparent 100%);
  mask-image: linear-gradient(90deg, #000 0%, #000 86%, transparent 100%);
}

.gd-tabs-line {
  display: inline-block;
  height: 72rpx;
  padding-right: 48rpx;
  white-space: nowrap;
  font-size: 0;
}

.gd-tab {
  display: inline-block;
  vertical-align: middle;
  margin-right: 40rpx;
  font-size: 28rpx;
}

.gd-feed {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 16rpx 24rpx 0;
}

.gd-card {
  overflow: hidden;
  border-radius: 24rpx;
  background: var(--surface);
  box-shadow: 0 2rpx 10rpx rgba(10, 42, 122, 0.05);
  transform: translateZ(0);
  transition: transform 0.18s ease;
}

.gd-card-on {
  transform: scale(0.985);
}

.gd-body {
  padding: 20rpx 24rpx 22rpx;
}

.gd-title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
  color: var(--ink);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.gd-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

.gd-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.gd-name {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.gd-badge {
  flex-shrink: 0;
  padding: 0 8rpx;
  border-radius: 6rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 20rpx;
  line-height: 32rpx;
}

.gd-cat {
  flex-shrink: 0;
  margin-left: auto;
}

.feed-end {
  padding: 24rpx 0 8rpx;
  text-align: center;
  color: var(--ink-4);
  font-size: 22rpx;
}

/* 骨架 */
.gd-sk {
  padding-bottom: 24rpx;
}

.gd-sk-cover {
  height: 299rpx;
  background: linear-gradient(90deg, #eef2f8 25%, #f6f8fc 50%, #eef2f8 75%);
  background-size: 400% 100%;
  animation: gd-shine 1.4s ease infinite;
}

.gd-sk-line {
  height: 28rpx;
  margin: 22rpx 24rpx 0;
  border-radius: 8rpx;
  background: #eef2f8;
}

.gd-sk-line.short {
  width: 40%;
  height: 22rpx;
}

@keyframes gd-shine {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}

/* 投稿按钮：tab 页窗口底边就是 tabBar 上沿，不用再加安全区 */
.gd-fab {
  position: fixed;
  right: 32rpx;
  bottom: 40rpx;
  z-index: 40;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 32rpx;
  border-radius: 999rpx;
  background: var(--ink);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 40rpx rgba(18, 26, 44, 0.28);
  transition: transform 0.15s ease;
}

.gd-fab-on {
  transform: scale(0.94);
}

.gd-fab-plus {
  color: var(--lime);
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1;
}
