<view class="xhs-note">
  <view wx:if="{{loading}}" class="xhs-empty">
    <view class="xhs-empty-ico comment"></view>
    <view class="xhs-empty-title">加载中</view>
  </view>
  <view wx:elif="{{loadError}}" class="xhs-empty">
    <view class="xhs-empty-ico comment"></view>
    <view class="xhs-empty-title">{{loadError}}</view>
    <view class="xhs-empty-desc">下拉可重试</view>
  </view>
  <block wx:else>
    <view wx:if="{{list.length}}" class="xhs-list">
      <view
        wx:for="{{list}}"
        wx:key="id"
        class="xhs-note-row"
        data-id="{{item.targetId}}"
        data-type="{{item.targetType}}"
        data-exists="{{item.postExists}}"
        bindtap="goPost"
        hover-class="xhs-note-on"
      >
        <image
          class="xhs-note-avatar"
          src="{{item.authorAvatar || '/images/default-avatars/avatar-01.jpg'}}"
          mode="aspectFill"
          data-userid="{{item.authorId}}"
          data-anonymous="{{item.anonymous}}"
          catchtap="goAuthor"
        />
        <view class="xhs-note-main">
          <view class="xhs-note-name">{{item.authorName}}</view>
          <view wx:if="{{item.content}}" class="xhs-note-body">{{item.content}}</view>
          <view wx:elif="{{item.images.length}}" class="xhs-note-body">[图片]</view>
          <view class="xhs-note-sub">
            <text>{{item.replyToName ? '回复了你' : '评论了你'}}</text>
            <text class="xhs-note-dot">·</text>
            <text>{{item.timeText}}</text>
          </view>
        </view>
        <image wx:if="{{item.postCover}}" class="xhs-thumb" src="{{item.postCover}}" mode="aspectFill" />
        <view wx:else class="xhs-thumb xhs-thumb-text">{{item.postExists ? item.postTitle : '不可用'}}</view>
      </view>
    </view>
    <view wx:else class="xhs-empty">
      <view class="xhs-empty-ico comment"></view>
      <view class="xhs-empty-title">还没有评论和@</view>
      <view class="xhs-empty-desc">别人评论你的帖子会出现在这里</view>
    </view>
  </block>
</view>
<user-card id="user-card" />
