.legal-page {
  min-height: 100vh;
  background: #F3F6FF;
  padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

.legal-head {
  padding: 12rpx 8rpx 28rpx;
}

.legal-title {
  font-size: 40rpx;
  font-weight: 760;
  color: #121A2C;
}

.legal-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #858D9C;
}

.legal-block {
  margin-bottom: 28rpx;
  padding: 28rpx 28rpx 8rpx;
  border-radius: 24rpx;
  background: #fff;
}

.legal-block.title-only {
  padding-bottom: 24rpx;
  background: transparent;
  box-shadow: none;
}

.legal-block.title-only .legal-h {
  font-size: 32rpx;
}

.legal-h {
  font-size: 30rpx;
  font-weight: 720;
  color: #121A2C;
  line-height: 1.45;
}

.legal-p {
  margin-top: 16rpx;
  padding-bottom: 16rpx;
  font-size: 26rpx;
  color: #3B4458;
  line-height: 1.75;
}
