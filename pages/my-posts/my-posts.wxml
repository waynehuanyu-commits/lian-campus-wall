<view class="page home-page mine-posts">
  <view class="top-bar home-top">
    <view class="home-tabs-row">
      <scroll-view class="tabs-scroll" scroll-x show-scrollbar="{{false}}">
        <view class="tabs-line home-tabs-line">
          <view
            wx:for="{{topics}}"
            wx:key="*this"
            class="tab-line home-tab-item {{topic === item ? 'active' : ''}}"
            data-name="{{item}}"
            bindtap="onTopicTap"
          >{{item}}</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{loadError}}" class="empty">
    <view class="empty-title">{{loadError}}</view>
    <view>重新进入页面可再试一次</view>
  </view>

  <view wx:elif="{{posts.length}}" class="feed">
    <view
      wx:for="{{posts}}"
      wx:key="uniq"
      class="feed-item feed-item-v2"
      data-id="{{item.id}}"
      data-type="{{item.contentType}}"
      bindtap="goDetail"
    >
      <view class="feed-head">
        <image class="avatar feed-avatar" src="{{item.authorAvatar}}" mode="aspectFill" />
        <view class="feed-head-main">
          <text class="author-name">{{item.authorName || '黎安人'}}</text>
          <text class="meta">{{item.timeText}}</text>
        </view>
      </view>
      <view wx:if="{{item.showTitle}}" class="post-title">
        <text wx:if="{{item.reviewLabel}}" class="pin-tag">{{item.reviewLabel}}</text>
        <text wx:if="{{item.official}}" class="pin-tag official">官方</text>{{item.title}}
      </view>
      <view wx:elif="{{item.reviewLabel || item.official}}" class="post-title post-title-flags">
        <text wx:if="{{item.reviewLabel}}" class="pin-tag">{{item.reviewLabel}}</text>
        <text wx:if="{{item.official}}" class="pin-tag official">官方</text>
      </view>
      <view wx:if="{{item.bodyText}}" class="post-content {{item.bodyOpen ? 'open' : ''}}">{{item.bodyText}}</view>
      <text wx:if="{{item.bodyLong}}" class="body-more" catchtap="toggleBody" data-id="{{item.id}}" data-type="{{item.contentType}}">{{item.bodyOpen ? '收起' : '展开'}}</text>
      <view wx:if="{{item.images && item.images.length}}" class="image-grid thumbs {{item.images.length > 1 ? 'multi' : 'single'}}">
        <image
          wx:for="{{item.images}}"
          wx:for-item="img"
          wx:for-index="imgIndex"
          wx:key="*this"
          src="{{img}}"
          mode="aspectFill"
          lazy-load
          data-postid="{{item.id}}"
          data-type="{{item.contentType}}"
          data-index="{{imgIndex}}"
          catchtap="previewImage"
        />
      </view>
      <view class="feed-foot">
        <view class="feed-stats" catchtap="preventBubble">
          <view class="feed-foot-left">
            <view wx:if="{{item.displayTag}}" class="feed-tag-pill">
              <text class="feed-tag-hash">#</text>
              <text>{{item.displayTag}}</text>
            </view>
            <text wx:if="{{item.viewCount > 0}}" class="feed-views">{{item.viewCount}}次围观</text>
          </view>
          <view class="stat-row">
            <view
              class="engage-item {{item.liked ? 'liked' : ''}}"
              catchtap="onLike"
              data-id="{{item.id}}"
              data-type="{{item.contentType}}"
            >
              <view class="engage-ic engage-ic-heart"></view>
              <text class="engage-num">{{item.likeCount}}</text>
            </view>
            <view class="engage-item" catchtap="goDetail" data-id="{{item.id}}" data-type="{{item.contentType}}">
              <view class="engage-ic engage-ic-comment"></view>
              <text class="engage-num">{{item.commentCount}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="feed-end">没有更多了 · 共{{posts.length}}条</view>
  </view>

  <view wx:elif="{{loading}}" class="empty">
    <view class="empty-title">正在加载</view>
  </view>

  <view wx:else class="empty">
    <view class="empty-title">{{topic === '官方' ? '还没有官方帖子' : '还没有帖子'}}</view>
    <view>换个主题，或发第一条吧</view>
  </view>
</view>
