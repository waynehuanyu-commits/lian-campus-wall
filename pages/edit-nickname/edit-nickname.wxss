.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f3f6fb;
  box-sizing: border-box;
}

.body {
  flex: 1;
  padding: 24rpx 32rpx 0;
}

.field {
  padding: 8rpx 28rpx 8rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(30, 70, 140, 0.04);
}

.field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
}

.label {
  font-size: 24rpx;
  font-weight: 600;
  color: #8a9199;
}

.count {
  font-size: 22rpx;
  color: #b0bac8;
}

.input {
  width: 100%;
  height: 96rpx;
  padding: 0;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
  box-sizing: border-box;
}

.ph {
  color: #c5ced9;
  font-weight: 500;
}

.tips {
  margin: 20rpx 12rpx 0;
  font-size: 24rpx;
  line-height: 1.6;
  color: #9aa3af;
}

.footer {
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(243, 246, 251, 0) 0%, #f3f6fb 28%);
}

.save-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #6aadff 0%, #2f7dff 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 650;
  box-shadow: 0 10rpx 24rpx rgba(47, 125, 255, 0.24);
  padding: 0;
  margin: 0;
}

.save-btn::after {
  border: none;
}

.save-btn-hover {
  filter: brightness(0.96);
  opacity: 0.92;
}

.save-btn.disabled {
  background: #c9d5e8;
  color: #fff;
  box-shadow: none;
}
