/* 与 campus-qr-card 同一套卡片：白底、24rpx 圆角、左右 24rpx 外边距 */
.ticker {
  position: relative;
  margin: 0 24rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 6rpx 20rpx rgba(10, 42, 122, 0.05);
  overflow: hidden;
}

.ticker-tag {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 2;
  padding: 4rpx 16rpx 6rpx 22rpx;
  border-radius: 0 24rpx 0 20rpx;
  background: linear-gradient(90deg, #ffc83d, #ffa21f);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.ticker-swiper {
  height: 104rpx;
}

.ticker-row {
  display: flex;
  align-items: center;
  height: 104rpx;
  padding: 10rpx 28rpx 0 26rpx;
  box-sizing: border-box;
}

.ticker-row-on {
  background: rgba(10, 92, 255, 0.04);
}

/* 皇冠：三个尖角 + 底座，名次写在底座上 */
.crown {
  position: relative;
  flex-shrink: 0;
  width: 46rpx;
  height: 40rpx;
  background: linear-gradient(180deg, #ffd84d, #ffb31a);
  margin-right: 18rpx;
  -webkit-clip-path: polygon(0 18%, 26% 46%, 50% 0, 74% 46%, 100% 18%, 92% 100%, 8% 100%);
  clip-path: polygon(0 18%, 26% 46%, 50% 0, 74% 46%, 100% 18%, 92% 100%, 8% 100%);
}

.crown-2 {
  background: linear-gradient(180deg, #e3e9f2, #b7c2d3);
}

.crown-3 {
  background: linear-gradient(180deg, #f2c49b, #d98f55);
}

.crown-num {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 2rpx;
  text-align: center;
  color: #6b4a00;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.crown-2 .crown-num {
  color: #4a5568;
}

.crown-3 .crown-num {
  color: #6e3a12;
}

.ticker-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #1a2233;
  font-size: 28rpx;
}

.ticker-go {
  flex-shrink: 0;
  margin-left: 12rpx;
  color: #a3acba;
  font-size: 36rpx;
  line-height: 1;
}
