.splash {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  background: #fff;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.splash.leaving {
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.18s ease;
}

.hero {
  width: 100%;
  height: 100%;
  display: block;
}
