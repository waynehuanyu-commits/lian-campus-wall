.privacy-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  background: rgba(20,36,64, 0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.privacy-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 40rpx 36rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
}

.privacy-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #232A3A;
  margin-bottom: 20rpx;
}

.privacy-body {
  font-size: 28rpx;
  line-height: 1.65;
  color: #5E6678;
  margin-bottom: 36rpx;
}

.privacy-link {
  color: #0A5CFF;
}

.privacy-actions {
  display: flex;
  gap: 20rpx;
}

.privacy-btn {
  flex: 1;
  margin: 0;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  font-size: 28rpx;
  font-weight: 500;
  padding: 0;
}

.privacy-btn::after {
  border: none;
}

.privacy-btn.ghost {
  background: #E9EFFF;
  color: #5E6678;
}

.privacy-btn.primary {
  background: #0A5CFF;
  color: #ffffff;
}
