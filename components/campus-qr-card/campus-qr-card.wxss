.qr-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 0 24rpx 20rpx;
  padding: 28rpx 28rpx 28rpx 32rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 6rpx 20rpx rgba(10, 42, 122, 0.05);
}

.qr-copy {
  flex: 1;
  min-width: 0;
}

.qr-id {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.qr-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #e9edf4;
}

.qr-name {
  color: #3b4458;
  font-size: 26rpx;
  font-weight: 600;
}

.qr-title {
  margin-top: 22rpx;
  color: #121a2c;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
}

.qr-desc {
  margin-top: 6rpx;
  color: #858d9c;
  font-size: 24rpx;
  line-height: 1.5;
}

.qr-code {
  flex-shrink: 0;
  width: 156rpx;
  height: 156rpx;
  display: block;
}
