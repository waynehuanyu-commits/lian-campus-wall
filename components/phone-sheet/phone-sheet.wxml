<view wx:if="{{show}}" class="mask" catchtouchmove="noop" bindtap="close">
  <view class="panel" catchtap="noop">
    <view class="title">验证手机号</view>
    <view class="desc">为了社区安全，发言前需要验证一次手机号。号码只用于账号安全核验，不会展示给任何其他用户。</view>
    <button
      class="bind-btn"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
      disabled="{{binding}}"
      loading="{{binding}}"
    >使用微信手机号验证</button>
    <view class="cancel" bindtap="close">暂不验证</view>
  </view>
</view>
