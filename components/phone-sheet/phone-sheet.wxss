.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 10000;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
}

.panel {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 36rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  text-align: center;
}

.desc {
  margin: 16rpx 0 32rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #6b7280;
  text-align: center;
}

.bind-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: #2f7dff;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.bind-btn::after {
  border: none;
}

.cancel {
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 8rpx;
  text-align: center;
  font-size: 28rpx;
  color: #6b7280;
}
