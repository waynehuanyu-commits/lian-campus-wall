.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 10000;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
}

.panel {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.title {
  font-size: 28rpx;
  color: #8a9199;
  text-align: center;
  margin-bottom: 12rpx;
}

.reason,
.cancel {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  color: #1f2937;
  border-top: 1rpx solid #eef1f5;
}

.cancel {
  margin-top: 12rpx;
  color: #6b7280;
  border-top: none;
}
