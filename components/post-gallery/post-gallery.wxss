.gallery {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.gallery-cell {
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
  background: #f2f3f5;
}

/* 多图：方形网格 */
.gallery.two .gallery-cell,
.gallery.multi .gallery-cell {
  height: 0;
}

.gallery.two .gallery-cell {
  width: calc((100% - 12rpx) / 2);
  padding-top: calc((100% - 12rpx) / 2);
}

.gallery.multi .gallery-cell {
  width: calc((100% - 24rpx) / 3);
  padding-top: calc((100% - 24rpx) / 3);
}

.gallery.two .gallery-img,
.gallery.multi .gallery-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* 单图：按原图比例，限制最大宽高，避免强行裁成正方形 */
.gallery.one {
  display: block;
}

.gallery.one .gallery-cell {
  width: 72%;
  max-width: 520rpx;
  height: auto;
  min-height: 200rpx;
  max-height: 720rpx;
}

.gallery.one .gallery-cell.one-long {
  width: 56%;
  max-width: 420rpx;
  max-height: 780rpx;
}

.gallery.one .gallery-img {
  display: block;
  width: 100%;
  height: 100%;
}

.gallery-fail {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a9199;
  font-size: 22rpx;
}

.gallery-fail.muted {
  color: #b0b4ba;
}
