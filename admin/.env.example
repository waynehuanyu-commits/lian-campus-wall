PORT=8787
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=change-me

# 本地演示：不配云库也能打开后台审帖/词库。配齐下面三项后自动切云库。
# ADMIN_LOCAL=1

# 微信云开发 / 腾讯云 API 密钥
