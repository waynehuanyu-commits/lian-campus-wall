.login-page {
  min-height: 100vh;
  padding: 80rpx 48rpx 60rpx;
  box-sizing: border-box;
  background: radial-gradient(circle at top left, #232A3A 0%, #121A2C 48%, #121A2C 100%);
  color: #E9EFFF;
  position: relative;
  overflow: hidden;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(8rpx);
  opacity: 0.45;
}

.orb-a {
  width: 280rpx;
  height: 280rpx;
  background: #0A5CFF;
  top: -60rpx;
  right: -40rpx;
}

.orb-b {
  width: 220rpx;
  height: 220rpx;
  background: #1f8f8a;
  bottom: 180rpx;
  left: -80rpx;
}

.brand {
  position: relative;
  z-index: 1;
  margin-top: 40rpx;
}

.mark {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #7FA6FF, #0A5CFF);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  box-shadow: 0 16rpx 40rpx rgba(10,92,255, 0.35);
}

.brand-kicker {
  margin-top: 36rpx;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #B4BAC5;
  font-weight: 700;
}

.brand-title {
  margin-top: 12rpx;
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.brand-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #B4BAC5;
  max-width: 560rpx;
}

.panel {
  position: relative;
  z-index: 1;
  margin-top: 56rpx;
  padding: 36rpx 32rpx 32rpx;
  border-radius: 32rpx;
  background: rgba(18,26,44, 0.78);
  border: 1rpx solid rgba(148,163,184, 0.16);
  backdrop-filter: blur(12px);
}

.field-label {
  margin: 8rpx 0 12rpx;
  font-size: 24rpx;
  color: #B4BAC5;
}

.field {
  height: 88rpx;
  border-radius: 18rpx;
  background: #121A2C;
  border: 1rpx solid rgba(148,163,184, 0.18);
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.field input {
  width: 100%;
  color: #E9EFFF;
  font-size: 28rpx;
}

.ph {
  color: #5E6678;
}

.login-btn {
  margin-top: 12rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #7FA6FF 0%, #0A5CFF 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
}

.login-btn::after {
  border: none;
}

.hint {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #858D9C;
}

.back {
  position: relative;
  z-index: 1;
  margin-top: 48rpx;
  text-align: center;
  color: #B4BAC5;
  font-size: 26rpx;
}
