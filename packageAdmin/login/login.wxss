.login-page {
  min-height: 100vh;
  padding: 80rpx 48rpx 60rpx;
  box-sizing: border-box;
  background: radial-gradient(circle at top left, #1b2a4a 0%, #0b1220 48%, #070b14 100%);
  color: #e8eefc;
  position: relative;
  overflow: hidden;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(8rpx);
  opacity: 0.45;
}

.orb-a {
  width: 280rpx;
  height: 280rpx;
  background: #3156d8;
  top: -60rpx;
  right: -40rpx;
}

.orb-b {
  width: 220rpx;
  height: 220rpx;
  background: #1f8f8a;
  bottom: 180rpx;
  left: -80rpx;
}

.brand {
  position: relative;
  z-index: 1;
  margin-top: 40rpx;
}

.mark {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #5b8cff, #2A6AE0);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  box-shadow: 0 16rpx 40rpx rgba(59, 130, 246, 0.35);
}

.brand-kicker {
  margin-top: 36rpx;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #8ea0c8;
  font-weight: 700;
}

.brand-title {
  margin-top: 12rpx;
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.brand-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #9aabc9;
  max-width: 560rpx;
}

.panel {
  position: relative;
  z-index: 1;
  margin-top: 56rpx;
  padding: 36rpx 32rpx 32rpx;
  border-radius: 32rpx;
  background: rgba(15, 23, 42, 0.78);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  backdrop-filter: blur(12px);
}

.field-label {
  margin: 8rpx 0 12rpx;
  font-size: 24rpx;
  color: #9aabc9;
}

.field {
  height: 88rpx;
  border-radius: 18rpx;
  background: #0b1220;
  border: 1rpx solid rgba(148, 163, 184, 0.18);
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.field input {
  width: 100%;
  color: #e8eefc;
  font-size: 28rpx;
}

.ph {
  color: #64748b;
}

.login-btn {
  margin-top: 12rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #60a5fa 0%, #2A6AE0 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
}

.login-btn::after {
  border: none;
}

.hint {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #7b8db0;
}

.back {
  position: relative;
  z-index: 1;
  margin-top: 48rpx;
  text-align: center;
  color: #8ea0c8;
  font-size: 26rpx;
}
